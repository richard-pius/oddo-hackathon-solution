# ==============================================================================
# Brightloop Software Subscription & Recurring Billing ERP - Environment Config
# ==============================================================================

# Database Settings (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://brightloop:brightloop_secret@db:5432/brightloop
DATABASE_URL_SYNC=postgresql://brightloop:brightloop_secret@db:5432/brightloop

# Local SQLite Fallback (Optional for non-docker local testing):
# DATABASE_URL=sqlite+aiosqlite:///./brightloop.db
# DATABASE_URL_SYNC=sqlite:///./brightloop.db

# JWT Authentication
SECRET_KEY=brightloop-dev-secret-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=15

# CORS Configuration
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# Billing Batch & APScheduler Settings
BILLING_BATCH_SIZE=500
BILLING_CRON_HOUR=0
BILLING_CRON_MINUTE=5

# Application Metadata
APP_NAME=Brightloop Subscription Manager
APP_VERSION=1.0.0

# Frontend Configuration
PUBLIC_API_URL=http://localhost:8000
