---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — Brightloop Enterprise ERP</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center py-12 sm:px-6 lg:px-8 font-['Plus_Jakarta_Sans',sans-serif]">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <!-- Brand Monogram -->
    <div class="flex items-center justify-center gap-3 mb-2">
      <div class="w-9 h-9 rounded bg-[#714B67] flex items-center justify-center font-bold text-white text-sm tracking-wider shadow-xs">
        BL
      </div>
      <div>
        <span class="text-xl font-bold tracking-tight text-slate-900">Brightloop ERP</span>
        <span class="ml-2 text-[10px] font-mono font-semibold uppercase px-1.5 py-0.5 rounded bg-slate-200 text-slate-700">v2.4 Enterprise</span>
      </div>
    </div>
    <h2 class="text-center text-sm font-medium text-slate-500">
      Mission-Critical Subscription & Recurring Billing
    </h2>
  </div>

  <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-6 border border-slate-200 rounded-md shadow-xs sm:px-10">
      
      <!-- Error Message Banner -->
      <div id="login-error" class="hidden mb-4 p-3 rounded bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-start gap-2" role="alert">
        <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="login-error-text">Authentication failed. Please verify credentials.</span>
      </div>

      <!-- Login Form -->
      <form id="login-form" class="space-y-4" novalidate>
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
            Work Email Address
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="admin@brightloop.io"
            class="block w-full px-3 py-2 text-sm text-slate-900 bg-white border border-slate-300 rounded-md placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#714B67] focus:border-[#714B67] transition-colors"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">
              Password
            </label>
            <span class="text-xs text-slate-400 font-normal">Encrypted bcrypt</span>
          </div>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            placeholder="••••••••••••"
            class="block w-full px-3 py-2 text-sm text-slate-900 bg-white border border-slate-300 rounded-md placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#714B67] focus:border-[#714B67] transition-colors"
          />
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
            <input type="checkbox" id="remember-me" checked class="rounded border-slate-300 text-[#714B67] focus:ring-[#714B67]" />
            <span>Keep session active</span>
          </label>
          <a href="#" class="text-indigo-600 hover:text-indigo-500 font-medium">Forgot password?</a>
        </div>

        <button
          type="submit"
          id="btn-submit"
          class="w-full mt-2 py-2 px-4 border border-transparent rounded-md text-sm font-medium text-white bg-[#714B67] hover:bg-[#5e3c55] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#714B67] transition-colors shadow-xs flex items-center justify-center gap-2"
        >
          <span id="btn-text">Sign In to Workspace</span>
          <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <!-- Evaluator Quick Switcher -->
      <div class="mt-6">
        <div class="relative">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-slate-200"></div>
          </div>
          <div class="relative flex justify-center text-xs uppercase">
            <span class="bg-white px-2 text-slate-400 font-semibold tracking-wider text-[11px]">
              Evaluator 1-Click Personas
            </span>
          </div>
        </div>

        <div class="mt-3 grid grid-cols-1 gap-2 text-xs">
          <button
            type="button"
            class="persona-btn flex items-center justify-between p-2 rounded border border-slate-200 hover:bg-slate-50 hover:border-slate-300 text-left transition-colors"
            data-email="admin@brightloop.io"
            data-pass="BrightloopAdmin2026!"
          >
            <div>
              <div class="font-semibold text-slate-800">Alex Morgan</div>
              <div class="text-[11px] text-slate-500 font-mono">admin@brightloop.io</div>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
              Admin
            </span>
          </button>

          <button
            type="button"
            class="persona-btn flex items-center justify-between p-2 rounded border border-slate-200 hover:bg-slate-50 hover:border-slate-300 text-left transition-colors"
            data-email="finance@brightloop.io"
            data-pass="BrightloopFinance2026!"
          >
            <div>
              <div class="font-semibold text-slate-800">Sarah Chen</div>
              <div class="text-[11px] text-slate-500 font-mono">finance@brightloop.io</div>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
              Finance
            </span>
          </button>

          <button
            type="button"
            class="persona-btn flex items-center justify-between p-2 rounded border border-slate-200 hover:bg-slate-50 hover:border-slate-300 text-left transition-colors"
            data-email="customer@brightloop.io"
            data-pass="BrightloopCustomer2026!"
          >
            <div>
              <div class="font-semibold text-slate-800">Acmez Enterprise</div>
              <div class="text-[11px] text-slate-500 font-mono">customer@brightloop.io</div>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-100 text-slate-700 border border-slate-200">
              Customer
            </span>
          </button>
        </div>
      </div>

      <!-- Registration link -->
      <div class="mt-6 text-center text-xs text-slate-600 border-t border-slate-100 pt-4">
        Need a self-service customer portal account?
        <a href="/register" class="font-semibold text-indigo-600 hover:text-indigo-500 ml-1">Register Company</a>
      </div>
    </div>

    <!-- Security Footnote -->
    <p class="mt-4 text-center text-xs text-slate-400">
      Zero-Trust Session Guard • Encrypted HTTP-only Token
    </p>
  </div>

  <script is:inline>
    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const errorBox = document.getElementById('login-error');
    const errorText = document.getElementById('login-error-text');
    const btnSubmit = document.getElementById('btn-submit');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    async function executeLogin(email, password) {
      errorBox.classList.add('hidden');
      btnSubmit.disabled = true;
      btnText.textContent = 'Authenticating...';
      btnSpinner.classList.remove('hidden');

      try {
        const res = await fetch('http://localhost:8000/api/v1/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        if (!res.ok) {
          let msg = 'Invalid work email or password';
          try {
            const err = await res.json();
            msg = err.detail || msg;
          } catch {}
          throw new Error(msg);
        }

        const data = await res.json();

        // Store access_token in document.cookie so Astro middleware and backend requests have immediate access
        document.cookie = `access_token=${data.access_token}; path=/; max-age=86400; SameSite=Lax`;

        // Store local storage auth profile for client utilities
        localStorage.setItem('brightloop_token', data.access_token);
        localStorage.setItem('brightloop_user', JSON.stringify({
          id: data.user_id,
          email: email,
          full_name: data.full_name,
          role: (data.role || 'customer').toLowerCase(),
          is_active: true,
        }));

        // Check redirect query param
        const urlParams = new URLSearchParams(window.location.search);
        const redirectParam = urlParams.get('redirect');

        if (redirectParam && !redirectParam.startsWith('/login') && !redirectParam.startsWith('/register')) {
          window.location.href = redirectParam;
        } else if (data.role.toLowerCase() === 'customer') {
          window.location.href = '/portal';
        } else {
          window.location.href = '/';
        }
      } catch (err) {
        errorText.textContent = err.message || 'Login failed';
        errorBox.classList.remove('hidden');
        btnSubmit.disabled = false;
        btnText.textContent = 'Sign In to Workspace';
        btnSpinner.classList.add('hidden');
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const password = passwordInput.value;
      if (!email || !password) {
        errorText.textContent = 'Please enter both work email and password.';
        errorBox.classList.remove('hidden');
        return;
      }
      executeLogin(email, password);
    });

    document.querySelectorAll('.persona-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const email = btn.getAttribute('data-email');
        const pass = btn.getAttribute('data-pass');
        emailInput.value = email;
        passwordInput.value = pass;
        executeLogin(email, pass);
      });
    });
  </script>
</body>
</html>
