---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In — Brightloop Enterprise ERP</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Instant Redirection if already authenticated -->
  <script is:inline>
    (function() {
      try {
        function getCookie(name) {
          const m = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
          return m ? decodeURIComponent(m[3]) : null;
        }
        const token = localStorage.getItem('brightloop_token') || getCookie('access_token');
        if (token) {
          try {
            const parts = token.split('.');
            if (parts.length === 3) {
              const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));
              if (!payload.exp || Date.now() < payload.exp * 1000) {
                const userRaw = localStorage.getItem('brightloop_user');
                const user = userRaw ? JSON.parse(userRaw) : null;
                if (user && user.role === 'customer') {
                  window.location.replace('/portal');
                } else {
                  window.location.replace('/');
                }
              }
            }
          } catch(e) {}
        }
      } catch(e) {}
    })();
  </script>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 font-['Plus_Jakarta_Sans',sans-serif] antialiased">
  
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <!-- Brand Monogram & Meta/Odoo Typography -->
    <div class="flex items-center justify-center gap-2.5 mb-2">
      <div class="w-8 h-8 rounded bg-[#714B67] flex items-center justify-center font-bold text-white text-xs tracking-wider shadow-2xs">
        BL
      </div>
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold tracking-tight text-slate-900">Brightloop ERP</span>
        <span class="text-[10px] font-mono font-semibold uppercase px-1.5 py-0.5 rounded bg-slate-200 text-slate-700 border border-slate-300">
          Enterprise
        </span>
      </div>
    </div>
    <p class="text-center text-xs text-slate-500 font-medium">
      Mission-Critical Subscription & Recurring Billing Management
    </p>
  </div>

  <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-md">
    <!-- Strict Utilitarian Card on bg-slate-50 Canvas -->
    <div class="bg-white py-7 px-6 border border-slate-200 rounded shadow-2xs sm:px-8">
      
      <div class="mb-5 pb-3 border-b border-slate-100">
        <h1 class="text-base font-bold text-slate-900 tracking-tight">Sign In to Workspace</h1>
        <p class="text-xs text-slate-500 mt-0.5">Enter your enterprise credentials to access your session.</p>
      </div>

      <!-- Clear Error State Container -->
      <div id="login-error" class="hidden mb-4 p-3 rounded border border-rose-200 bg-rose-50 text-rose-700 text-xs flex items-start gap-2.5" role="alert">
        <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div id="login-error-text" class="font-medium">Invalid email or password. Please verify your credentials.</div>
      </div>

      <!-- Login Form with Top-Aligned Labels and 1px border-slate-300 -->
      <form id="login-form" class="space-y-4" novalidate>
        
        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Work Email Address
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="name@company.com"
            class="block w-full px-3 py-2 text-xs font-normal text-slate-900 bg-white border border-slate-300 rounded placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2] transition-colors"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider">
              Password
            </label>
            <span class="text-[11px] text-slate-400 font-mono">Encrypted bcrypt</span>
          </div>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            placeholder="••••••••••••"
            class="block w-full px-3 py-2 text-xs font-normal text-slate-900 bg-white border border-slate-300 rounded placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2] transition-colors"
          />
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <label class="flex items-center gap-2 text-slate-600 cursor-pointer">
            <input type="checkbox" id="remember-me" checked class="rounded border-slate-300 text-[#1877F2] focus:ring-[#1877F2]" />
            <span>Keep session active</span>
          </label>
          <span class="text-slate-400 text-[11px]">Zero-Trust Guarded</span>
        </div>

        <!-- Primary Brand-Colored Button (Meta Blue #1877F2) with Loading State -->
        <button
          type="submit"
          id="btn-submit"
          class="w-full mt-2 py-2 px-4 rounded text-xs font-semibold text-white bg-[#1877F2] hover:bg-[#166fe5] focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-[#1877F2] transition-colors shadow-2xs flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Sign In</span>
          <svg id="btn-spinner" class="hidden w-3.5 h-3.5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <!-- Registration link -->
      <div class="mt-5 text-center text-xs text-slate-600 border-t border-slate-100 pt-3.5">
        Need a self-service customer portal account?
        <a href="/register" class="font-semibold text-[#1877F2] hover:underline ml-1">Register Company</a>
      </div>
    </div>

    <!-- Security Footnote -->
    <p class="mt-4 text-center text-[11px] text-slate-400 font-mono">
      Session Guard Active • Strict JWT Isolation
    </p>
  </div>

  <script is:inline>
    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const errorBox = document.getElementById('login-error');
    const errorText = document.getElementById('login-error-text');
    const btnSubmit = document.getElementById('btn-submit');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    async function executeLogin(email, password) {
      errorBox.classList.add('hidden');
      btnSubmit.disabled = true;
      btnText.textContent = 'Authenticating...';
      btnSpinner.classList.remove('hidden');

      const defaultUrl = (window.PUBLIC_API_URL || localStorage.getItem('brightloop_api_url') || 'http://localhost:8000').replace(/\/$/, '');
      let res = null;
      let activeApiUrl = defaultUrl;

      try {
        try {
          res = await fetch(`${defaultUrl}/api/v1/auth/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });
        } catch (netErr) {
          // If port 8000 was unreachable, attempt port 8001 fallback in case backend is running on 8001
          if (defaultUrl.includes(':8000')) {
            try {
              const fallbackUrl = defaultUrl.replace(':8000', ':8001');
              res = await fetch(`${fallbackUrl}/api/v1/auth/login`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password }),
              });
              activeApiUrl = fallbackUrl;
              localStorage.setItem('brightloop_api_url', fallbackUrl);
            } catch {}
          }
        }

        if (!res) {
          throw new Error(`Unable to connect to backend server (${defaultUrl} or port 8001). Please make sure the FastAPI backend is running.`);
        }

        if (!res.ok) {
          let msg = 'Invalid email or password.';
          try {
            const err = await res.json();
            msg = err.detail || msg;
          } catch {}
          throw new Error(msg);
        }

        const data = await res.json();

        // 1. Set browser cookie for SSR / middleware check
        document.cookie = `access_token=${data.access_token}; path=/; max-age=86400; SameSite=Lax`;

        // 2. Set localStorage for client-side API requests
        localStorage.setItem('brightloop_token', data.access_token);
        localStorage.setItem('brightloop_api_url', activeApiUrl);
        localStorage.setItem('brightloop_user', JSON.stringify({
          id: data.user_id,
          email: email,
          full_name: data.full_name,
          role: (data.role || 'customer').toLowerCase(),
          is_active: true,
        }));

        // 3. Evaluate redirect destination
        const urlParams = new URLSearchParams(window.location.search);
        const redirectParam = urlParams.get('redirect');

        if (redirectParam && !redirectParam.startsWith('/login') && !redirectParam.startsWith('/register')) {
          window.location.replace(redirectParam);
        } else if (data.role && data.role.toLowerCase() === 'customer') {
          window.location.replace('/portal');
        } else {
          window.location.replace('/');
        }
      } catch (err) {
        errorText.textContent = err.message || 'Invalid email or password.';
        errorBox.classList.remove('hidden');
        btnSubmit.disabled = false;
        btnText.textContent = 'Sign In';
        btnSpinner.classList.add('hidden');
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      const password = passwordInput.value;
      if (!email || !password) {
        errorText.textContent = 'Please enter both work email and password.';
        errorBox.classList.remove('hidden');
        return;
      }
      executeLogin(email, password);
    });
  </script>
</body>
</html>
