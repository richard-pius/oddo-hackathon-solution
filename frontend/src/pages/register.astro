---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register Company — Brightloop Enterprise ERP</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Instant Redirection if already authenticated -->
  <script is:inline>
    (function() {
      try {
        function getCookie(name) {
          const m = document.cookie.match(new RegExp('(^|;\\s*)(' + name + ')=([^;]*)'));
          return m ? decodeURIComponent(m[3]) : null;
        }
        const token = localStorage.getItem('brightloop_token') || getCookie('access_token');
        if (token) {
          try {
            const parts = token.split('.');
            if (parts.length === 3) {
              const payload = JSON.parse(atob(parts[1].replace(/-/g, '+').replace(/_/g, '/')));
              if (!payload.exp || Date.now() < payload.exp * 1000) {
                window.location.replace('/portal');
              }
            }
          } catch(e) {}
        }
      } catch(e) {}
    })();
  </script>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 font-['Plus_Jakarta_Sans',sans-serif] antialiased">
  
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <!-- Brand Monogram -->
    <div class="flex items-center justify-center gap-2.5 mb-2">
      <div class="w-8 h-8 rounded bg-[#714B67] flex items-center justify-center font-bold text-white text-xs tracking-wider shadow-2xs">
        BL
      </div>
      <div class="flex items-center gap-2">
        <span class="text-lg font-bold tracking-tight text-slate-900">Brightloop ERP</span>
        <span class="text-[10px] font-mono font-semibold uppercase px-1.5 py-0.5 rounded bg-slate-200 text-slate-700 border border-slate-300">
          Self-Service
        </span>
      </div>
    </div>
    <p class="text-center text-xs text-slate-500 font-medium">
      Create Customer Tenant Account & Access Self-Service Billing
    </p>
  </div>

  <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-md">
    <!-- Utilitarian Card on bg-slate-50 Canvas -->
    <div class="bg-white py-7 px-6 border border-slate-200 rounded shadow-2xs sm:px-8">
      
      <div class="mb-5 pb-3 border-b border-slate-100">
        <h1 class="text-base font-bold text-slate-900 tracking-tight">Register Organization</h1>
        <p class="text-xs text-slate-500 mt-0.5">Enter authorized corporate details to provision your tenant.</p>
      </div>

      <!-- Clear Error State Container -->
      <div id="register-error" class="hidden mb-4 p-3 rounded border border-rose-200 bg-rose-50 text-rose-700 text-xs flex items-start gap-2.5" role="alert">
        <svg class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div id="register-error-text" class="font-medium">Registration failed. Please check inputs.</div>
      </div>

      <!-- Registration Form with Top-Aligned Labels -->
      <form id="register-form" class="space-y-4" novalidate>
        
        <div>
          <label for="full_name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Company / Authorized Representative
          </label>
          <input
            id="full_name"
            name="full_name"
            type="text"
            autocomplete="name"
            required
            placeholder="e.g. Apex Global Systems LLC"
            class="block w-full px-3 py-2 text-xs font-normal text-slate-900 bg-white border border-slate-300 rounded placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2] transition-colors"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Corporate Email Address
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            placeholder="billing@apexsystems.com"
            class="block w-full px-3 py-2 text-xs font-normal text-slate-900 bg-white border border-slate-300 rounded placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2] transition-colors"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Account Password
          </label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            required
            placeholder="••••••••••••"
            class="block w-full px-3 py-2 text-xs font-normal text-slate-900 bg-white border border-slate-300 rounded placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2] transition-colors"
          />
          
          <!-- Strict Password Rules Checklist -->
          <div class="mt-2.5 p-2.5 rounded bg-slate-50 border border-slate-200 text-[11px] space-y-1">
            <div class="font-semibold text-slate-600 mb-1 text-[10px] uppercase tracking-wider">Password Requirements:</div>
            <div id="rule-length" class="flex items-center gap-1.5 text-slate-500 transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 rule-dot"></span>
              <span>Minimum 9 characters</span>
            </div>
            <div id="rule-upper" class="flex items-center gap-1.5 text-slate-500 transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 rule-dot"></span>
              <span>At least one uppercase letter (A-Z)</span>
            </div>
            <div id="rule-lower" class="flex items-center gap-1.5 text-slate-500 transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 rule-dot"></span>
              <span>At least one lowercase letter (a-z)</span>
            </div>
            <div id="rule-special" class="flex items-center gap-1.5 text-slate-500 transition-colors">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-300 rule-dot"></span>
              <span>At least one special character (!@#$%^&*...)</span>
            </div>
          </div>
        </div>

        <div>
          <label for="confirm_password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1.5">
            Confirm Password
          </label>
          <input
            id="confirm_password"
            name="confirm_password"
            type="password"
            autocomplete="new-password"
            required
            placeholder="••••••••••••"
            class="block w-full px-3 py-2 text-xs font-normal text-slate-900 bg-white border border-slate-300 rounded placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2] transition-colors"
          />
        </div>

        <div class="flex items-start gap-2 pt-1">
          <input type="checkbox" id="terms" required checked class="mt-0.5 rounded border-slate-300 text-[#1877F2] focus:ring-[#1877F2]" />
          <label for="terms" class="text-xs text-slate-600">
            I agree to the <span class="text-slate-800 font-medium">Master Subscription Agreement</span> and billing terms.
          </label>
        </div>

        <!-- Submit Button with Loading State -->
        <button
          type="submit"
          id="btn-register"
          class="w-full mt-2 py-2 px-4 rounded text-xs font-semibold text-white bg-[#1877F2] hover:bg-[#166fe5] focus:outline-none focus:ring-2 focus:ring-offset-1 focus:ring-[#1877F2] transition-colors shadow-2xs flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Create Customer Account</span>
          <svg id="btn-spinner" class="hidden w-3.5 h-3.5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      <!-- Return to Login -->
      <div class="mt-5 text-center text-xs text-slate-600 border-t border-slate-100 pt-3.5">
        Already registered?
        <a href="/login" class="font-semibold text-[#1877F2] hover:underline ml-1">Sign In to Workspace</a>
      </div>
    </div>

    <!-- Security Footnote -->
    <p class="mt-4 text-center text-[11px] text-slate-400 font-mono">
      Tenant Isolation Enforced • Bcrypt Encrypted
    </p>
  </div>

  <script is:inline>
    const form = document.getElementById('register-form');
    const fullNameInput = document.getElementById('full_name');
    const emailInput = document.getElementById('email');
    const passwordInput = document.getElementById('password');
    const confirmInput = document.getElementById('confirm_password');
    const termsInput = document.getElementById('terms');
    const errorBox = document.getElementById('register-error');
    const errorText = document.getElementById('register-error-text');
    const btnSubmit = document.getElementById('btn-register');
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    const ruleLength = document.getElementById('rule-length');
    const ruleUpper = document.getElementById('rule-upper');
    const ruleLower = document.getElementById('rule-lower');
    const ruleSpecial = document.getElementById('rule-special');

    // Live password check helper
    function updatePasswordRequirements(val) {
      const isLength = val.length >= 9;
      const isUpper = /[A-Z]/.test(val);
      const isLower = /[a-z]/.test(val);
      const isSpecial = /[!@#$%^&*(),.?":{}|<>\-_+=]/.test(val);

      setRuleState(ruleLength, isLength);
      setRuleState(ruleUpper, isUpper);
      setRuleState(ruleLower, isLower);
      setRuleState(ruleSpecial, isSpecial);

      return isLength && isUpper && isLower && isSpecial;
    }

    function setRuleState(el, valid) {
      const dot = el.querySelector('.rule-dot');
      if (valid) {
        el.classList.remove('text-slate-500');
        el.classList.add('text-emerald-700', 'font-medium');
        dot.classList.remove('bg-slate-300');
        dot.classList.add('bg-emerald-500');
      } else {
        el.classList.remove('text-emerald-700', 'font-medium');
        el.classList.add('text-slate-500');
        dot.classList.remove('bg-emerald-500');
        dot.classList.add('bg-slate-300');
      }
    }

    passwordInput.addEventListener('input', () => {
      updatePasswordRequirements(passwordInput.value);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.add('hidden');

      const fullName = fullNameInput.value.trim();
      const email = emailInput.value.trim();
      const password = passwordInput.value;
      const confirmPassword = confirmInput.value;

      if (!fullName || !email || !password) {
        errorText.textContent = 'Please fill out all required fields.';
        errorBox.classList.remove('hidden');
        return;
      }

      const isValidPassword = updatePasswordRequirements(password);
      if (!isValidPassword) {
        errorText.textContent = 'Password does not meet the strict security requirements (minimum 9 characters, uppercase, lowercase, special character).';
        errorBox.classList.remove('hidden');
        return;
      }

      if (password !== confirmPassword) {
        errorText.textContent = 'Passwords do not match.';
        errorBox.classList.remove('hidden');
        return;
      }

      if (!termsInput.checked) {
        errorText.textContent = 'Please agree to the Master Subscription Agreement.';
        errorBox.classList.remove('hidden');
        return;
      }

      btnSubmit.disabled = true;
      btnText.textContent = 'Creating account...';
      btnSpinner.classList.remove('hidden');

      try {
        const apiBase = (window.PUBLIC_API_URL || localStorage.getItem('brightloop_api_url') || 'http://localhost:8000').replace(/\/$/, '');
        const res = await fetch(`${apiBase}/api/v1/auth/register`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name: fullName,
            email: email,
            password: password,
          }),
        });

        if (!res.ok) {
          let msg = 'Registration failed. Email may already be in use.';
          try {
            const err = await res.json();
            msg = err.detail || msg;
          } catch {}
          throw new Error(msg);
        }

        const data = await res.json();

        // 1. Set cookie for immediate SSR / middleware compatibility
        document.cookie = `access_token=${data.access_token}; path=/; max-age=86400; SameSite=Lax`;

        // 2. Set localStorage auth credentials
        localStorage.setItem('brightloop_token', data.access_token);
        localStorage.setItem('brightloop_user', JSON.stringify({
          id: data.user_id,
          email: email,
          full_name: data.full_name,
          role: 'customer',
          is_active: true,
        }));

        // 3. Immediately redirect new customer directly to customer portal
        window.location.replace('/portal');
      } catch (err) {
        errorText.textContent = err.message || 'Registration failed.';
        errorBox.classList.remove('hidden');
        btnSubmit.disabled = false;
        btnText.textContent = 'Create Customer Account';
        btnSpinner.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
