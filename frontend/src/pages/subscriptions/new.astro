---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="New Subscription Quotation — Brightloop ERP" activeNav="subscriptions" breadcrumbs={[{ label: 'Brightloop ERP', href: '/' }, { label: 'Subscriptions', href: '/subscriptions' }, { label: 'New Quotation' }]}>
  <div class="max-w-5xl mx-auto space-y-4">
    
    <!-- Header -->
    <div class="border-b border-slate-200 pb-3">
      <h1 class="text-xl font-bold text-slate-900 tracking-tight">Create Subscription Quotation</h1>
      <p class="text-xs text-slate-500 mt-0.5">Configure products, variant price modifiers (+560 Odoo brand), multi-tier discounts, and billing intervals.</p>
    </div>

    <!-- Quick Template Auto-Fill Banner -->
    <div class="bg-white border border-slate-200 rounded-md p-3 shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded bg-slate-100 border border-slate-200 flex items-center justify-center text-[#714B67]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        </div>
        <div>
          <div class="font-bold text-xs text-slate-900">Quotation Template Quick-Fill</div>
          <div class="text-[11px] text-slate-500">Apply a predefined enterprise bundle with automated rules.</div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <select id="template-select" class="bg-white border border-slate-300 text-xs text-slate-900 rounded px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
          <option value="">-- Select Template --</option>
        </select>
        <button id="btn-apply-template" class="px-3 py-1.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white font-semibold text-xs shadow-2xs">
          Apply
        </button>
      </div>
    </div>

    <!-- Contract Master Form Sheet -->
    <div class="bg-white border border-slate-200 rounded-md p-5 shadow-xs space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Customer Selection -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">
            Customer Account <span class="text-rose-500">*</span>
          </label>
          <select id="field-customer" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="">Loading customer accounts...</option>
          </select>
        </div>

        <!-- Plan Selection -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">
            Subscription Plan <span class="text-rose-500">*</span>
          </label>
          <select id="field-plan" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="">Loading plans...</option>
          </select>
        </div>

        <!-- Start Date -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">
            Contract Start Date <span class="text-rose-500">*</span>
          </label>
          <input 
            type="date" 
            id="field-start-date" 
            class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]"
          />
        </div>

        <!-- Payment Terms -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">
            Payment Terms
          </label>
          <select id="field-payment-terms" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="Immediate Payment">Immediate Payment</option>
            <option value="Net 15">Net 15 Days</option>
            <option value="Net 30" selected>Net 30 Days</option>
            <option value="Net 60">Net 60 Days</option>
          </select>
        </div>

        <!-- Promotional Discount Rule -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">
            Applied Discount / Promo Rule
          </label>
          <select id="field-discount" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="">None (Standard Pricing)</option>
          </select>
        </div>

        <!-- Notes -->
        <div>
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-1">
            Contract Notes / PO Ref
          </label>
          <input 
            type="text" 
            id="field-notes" 
            placeholder="e.g. PO-2026-ALPHA approved by VP" 
            class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]"
          />
        </div>
      </div>

      <!-- Line Items Section -->
      <div class="pt-3 border-t border-slate-100">
        <div class="flex items-center justify-between mb-2">
          <div>
            <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Recurring Order Lines</h3>
            <p class="text-[11px] text-slate-500">Configure product variants, Odoo branding attributes, and quantities.</p>
          </div>
          <button 
            type="button" 
            id="btn-add-line" 
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium shadow-2xs"
          >
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <span>Add Line Item</span>
          </button>
        </div>

        <div class="overflow-x-auto border border-slate-200 rounded">
          <table class="erp-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Variant (e.g. Odoo +560)</th>
                <th class="w-24">Qty</th>
                <th class="w-28">Unit Price</th>
                <th class="w-32">Subtotal</th>
                <th class="w-12 text-center"></th>
              </tr>
            </thead>
            <tbody id="lines-table-body">
              <!-- Dynamically populated lines -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Financial Totals Summary Box -->
      <div class="flex justify-end pt-2">
        <div class="w-full sm:w-72 bg-slate-50 p-3.5 rounded border border-slate-200 space-y-1.5 text-xs font-mono">
          <div class="flex items-center justify-between text-slate-600">
            <span>Subtotal (Recurring):</span>
            <span class="text-slate-900 font-bold" id="summary-subtotal">$0.00</span>
          </div>
          <div class="flex items-center justify-between text-slate-600">
            <span>Discount:</span>
            <span class="text-emerald-700 font-bold" id="summary-discount">-$0.00</span>
          </div>
          <div class="flex items-center justify-between text-slate-600">
            <span>Estimated Tax (18% GST):</span>
            <span class="text-slate-900 font-bold" id="summary-tax">$0.00</span>
          </div>
          <div class="border-t border-slate-200 pt-1.5 flex items-center justify-between text-sm">
            <span class="font-bold text-slate-900 font-sans">Recurring Value:</span>
            <span class="text-[#714B67] font-extrabold text-base" id="summary-total">$0.00</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
        <a href="/subscriptions" class="px-3.5 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium">
          Cancel
        </a>
        <button 
          id="btn-save-draft" 
          class="px-4 py-1.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
          <span>Create Subscription Quotation</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch } from '../../lib/api';

    let catalogProducts: any[] = [];
    let catalogPlans: any[] = [];
    let discountRules: any[] = [];
    let quotationTemplates: any[] = [];
    let rowCounter = 0;

    const todayStr = new Date().toISOString().split('T')[0];
    const startDateInput = document.getElementById('field-start-date') as HTMLInputElement;
    if (startDateInput) startDateInput.value = todayStr;

    async function initializeCatalogData() {
      const [prodsRes, plansRes, discsRes, tmplsRes, usersRes] = await Promise.all([
        apiFetch<any>('/api/v1/catalog/products'),
        apiFetch<any>('/api/v1/catalog/plans'),
        apiFetch<any>('/api/v1/catalog/discounts'),
        apiFetch<any>('/api/v1/catalog/quotation-templates'),
        apiFetch<any>('/api/v1/auth/users'),
      ]);

      if (prodsRes.data) catalogProducts = prodsRes.data;
      if (plansRes.data) catalogPlans = plansRes.data;
      if (discsRes.data) discountRules = discsRes.data;
      if (tmplsRes.data) quotationTemplates = tmplsRes.data;

      // Populate Plans
      const planSelect = document.getElementById('field-plan');
      if (planSelect && catalogPlans.length > 0) {
        planSelect.innerHTML = catalogPlans.map(p => `
          <option value="${p.id}">${p.name} (${p.billing_interval.toUpperCase()})</option>
        `).join('');
      }

      // Populate Customers
      const custSelect = document.getElementById('field-customer');
      if (custSelect) {
        const users = usersRes.data || [
          { id: 3, full_name: 'Acmez Enterprise Customer', email: 'customer@brightloop.io' },
          { id: 1, full_name: 'Alex Morgan (Admin Account)', email: 'admin@brightloop.io' }
        ];
        custSelect.innerHTML = users.map((u: any) => `
          <option value="${u.id}">${u.full_name} (${u.email})</option>
        `).join('');
      }

      // Populate Discounts
      const discSelect = document.getElementById('field-discount');
      if (discSelect && discountRules.length > 0) {
        discSelect.innerHTML = '<option value="">None (Standard Pricing)</option>' + discountRules.map(d => `
          <option value="${d.id}">${d.code} — ${d.name} (${d.discount_type === 'percentage' ? d.value + '%' : '$' + d.value})</option>
        `).join('');
      }

      // Populate Quotation Templates
      const tmplSelect = document.getElementById('template-select');
      if (tmplSelect && quotationTemplates.length > 0) {
        tmplSelect.innerHTML = '<option value="">-- Select Template --</option>' + quotationTemplates.map(t => `
          <option value="${t.id}">${t.name} (${t.payment_terms})</option>
        `).join('');
      }

      addLineItem();
    }

    function addLineItem(productId?: number, variantId?: number, quantity: number = 1) {
      const tbody = document.getElementById('lines-table-body');
      if (!tbody) return;

      rowCounter++;
      const rowId = `line-row-${rowCounter}`;

      const tr = document.createElement('tr');
      tr.id = rowId;
      tr.className = 'line-item-row';

      const selectedProd = catalogProducts.find(p => p.id === productId) || catalogProducts[0];
      const prodOptions = catalogProducts.map(p => `
        <option value="${p.id}" ${p.id === selectedProd?.id ? 'selected' : ''}>${p.name} ($${p.base_price})</option>
      `).join('');

      tr.innerHTML = `
        <td>
          <select class="line-product-select w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            ${prodOptions}
          </select>
        </td>
        <td>
          <select class="line-variant-select w-full bg-white border border-slate-300 rounded px-2 py-1 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="">Standard Edition</option>
          </select>
        </td>
        <td>
          <input type="number" min="1" value="${quantity}" class="line-qty-input w-20 bg-white border border-slate-300 rounded px-2 py-1 text-xs text-slate-900 font-mono text-center focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </td>
        <td class="font-mono font-medium text-slate-700 line-unit-price">$0.00</td>
        <td class="font-mono font-bold text-slate-900 line-total-price">$0.00</td>
        <td class="text-center">
          <button type="button" class="btn-remove-line text-slate-400 hover:text-rose-600 p-1 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </td>
      `;

      tbody.appendChild(tr);

      const prodSelect = tr.querySelector('.line-product-select') as HTMLSelectElement;
      const varSelect = tr.querySelector('.line-variant-select') as HTMLSelectElement;
      const qtyInput = tr.querySelector('.line-qty-input') as HTMLInputElement;
      const removeBtn = tr.querySelector('.btn-remove-line') as HTMLButtonElement;

      function updateVariants() {
        const pId = Number(prodSelect.value);
        const prod = catalogProducts.find(p => p.id === pId);
        if (!prod || !prod.variants || prod.variants.length === 0) {
          varSelect.innerHTML = '<option value="">Standard Edition (+$0)</option>';
        } else {
          varSelect.innerHTML = '<option value="">Standard Edition (+$0)</option>' + prod.variants.map((v: any) => {
            const attrText = Object.entries(v.attributes || {}).map(([k, val]) => `${k}: ${val}`).join(', ');
            const extra = Number(v.price_extra || 0);
            return `<option value="${v.id}" ${variantId === v.id ? 'selected' : ''}>${v.sku} [${attrText}] (+${formatUSD(extra)})</option>`;
          }).join('');
        }
        calculateTotals();
      }

      prodSelect.addEventListener('change', updateVariants);
      varSelect.addEventListener('change', calculateTotals);
      qtyInput.addEventListener('input', calculateTotals);

      removeBtn.addEventListener('click', () => {
        if (document.querySelectorAll('.line-item-row').length > 1) {
          tr.remove();
          calculateTotals();
        } else {
          alert('A subscription requires at least one line item');
        }
      });

      updateVariants();
    }

    function calculateTotals() {
      let subtotal = 0;
      const rows = document.querySelectorAll('.line-item-row');

      rows.forEach(row => {
        const pSelect = row.querySelector('.line-product-select') as HTMLSelectElement;
        const vSelect = row.querySelector('.line-variant-select') as HTMLSelectElement;
        const qInput = row.querySelector('.line-qty-input') as HTMLInputElement;
        const unitEl = row.querySelector('.line-unit-price') as HTMLElement;
        const totalEl = row.querySelector('.line-total-price') as HTMLElement;

        const prod = catalogProducts.find(p => p.id === Number(pSelect.value));
        const basePrice = Number(prod?.base_price || 0);

        let extra = 0;
        if (vSelect.value && prod?.variants) {
          const v = prod.variants.find((vr: any) => vr.id === Number(vSelect.value));
          if (v) extra = Number(v.price_extra || 0);
        }

        const effectiveUnit = basePrice + extra;
        const qty = Math.max(1, Number(qInput.value || 1));
        const lineTotal = effectiveUnit * qty;

        unitEl.textContent = formatUSD(effectiveUnit);
        totalEl.textContent = formatUSD(lineTotal);
        subtotal += lineTotal;
      });

      // Discount
      let discountAmount = 0;
      const discSelect = document.getElementById('field-discount') as HTMLSelectElement;
      if (discSelect.value) {
        const disc = discountRules.find(d => d.id === Number(discSelect.value));
        if (disc) {
          if (disc.discount_type === 'percentage') {
            discountAmount = subtotal * (Number(disc.value) / 100);
          } else {
            discountAmount = Math.min(subtotal, Number(disc.value));
          }
        }
      }

      const taxableBase = Math.max(0, subtotal - discountAmount);
      const taxAmount = taxableBase * 0.18; // 18% GST standard
      const finalTotal = taxableBase + taxAmount;

      document.getElementById('summary-subtotal')!.textContent = formatUSD(subtotal);
      document.getElementById('summary-discount')!.textContent = `-${formatUSD(discountAmount)}`;
      document.getElementById('summary-tax')!.textContent = formatUSD(taxAmount);
      document.getElementById('summary-total')!.textContent = formatUSD(finalTotal);
    }

    function formatUSD(val: number): string {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(val);
    }

    document.getElementById('btn-add-line')?.addEventListener('click', () => addLineItem());
    document.getElementById('field-discount')?.addEventListener('change', calculateTotals);

    document.getElementById('btn-apply-template')?.addEventListener('click', async () => {
      const tmplSelect = document.getElementById('template-select') as HTMLSelectElement;
      const tmplId = Number(tmplSelect.value);
      if (!tmplId) return;

      const tmpl = quotationTemplates.find(t => t.id === tmplId);
      if (!tmpl) return;

      const planSelect = document.getElementById('field-plan') as HTMLSelectElement;
      if (planSelect && tmpl.plan_id) planSelect.value = String(tmpl.plan_id);

      const ptSelect = document.getElementById('field-payment-terms') as HTMLSelectElement;
      if (ptSelect && tmpl.payment_terms) ptSelect.value = tmpl.payment_terms;

      const tbody = document.getElementById('lines-table-body');
      if (tbody) tbody.innerHTML = '';

      if (tmpl.template_lines && tmpl.template_lines.length > 0) {
        tmpl.template_lines.forEach((tl: any) => {
          addLineItem(tl.product_id, tl.variant_id, tl.quantity);
        });
      } else {
        addLineItem();
      }

      calculateTotals();
    });

    document.getElementById('btn-save-draft')?.addEventListener('click', async () => {
      const custSelect = document.getElementById('field-customer') as HTMLSelectElement;
      const planSelect = document.getElementById('field-plan') as HTMLSelectElement;
      const startDateInput = document.getElementById('field-start-date') as HTMLInputElement;
      const ptSelect = document.getElementById('field-payment-terms') as HTMLSelectElement;
      const discSelect = document.getElementById('field-discount') as HTMLSelectElement;
      const notesInput = document.getElementById('field-notes') as HTMLInputElement;

      const customerId = Number(custSelect.value);
      const planId = Number(planSelect.value);
      const startDate = startDateInput.value;

      if (!customerId || !planId || !startDate) {
        alert('Please specify Customer, Plan, and Start Date');
        return;
      }

      const lines: any[] = [];
      document.querySelectorAll('.line-item-row').forEach(row => {
        const pSelect = row.querySelector('.line-product-select') as HTMLSelectElement;
        const vSelect = row.querySelector('.line-variant-select') as HTMLSelectElement;
        const qInput = row.querySelector('.line-qty-input') as HTMLInputElement;

        lines.push({
          product_id: Number(pSelect.value),
          variant_id: vSelect.value ? Number(vSelect.value) : null,
          quantity: Math.max(1, Number(qInput.value || 1)),
          description: '',
        });
      });

      const payload = {
        customer_id: customerId,
        plan_id: planId,
        start_date: startDate,
        payment_terms: ptSelect.value,
        applied_discount_id: discSelect.value ? Number(discSelect.value) : null,
        notes: notesInput.value || null,
        lines,
      };

      const btn = document.getElementById('btn-save-draft') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<span>Creating Contract...</span>';

      const res = await apiFetch<any>('/api/v1/subscriptions/', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (res.data?.id) {
        window.location.href = `/subscriptions/${res.data.id}`;
      } else {
        btn.disabled = false;
        btn.innerHTML = '<span>Create Subscription Quotation</span>';
        alert(`Creation Failed: ${res.error || 'Server error'}`);
      }
    });

    initializeCatalogData();
  </script>
</Layout>
