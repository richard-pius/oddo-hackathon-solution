---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="New Subscription Quotation — Brightloop ERP" activeNav="subscriptions">
  <div class="max-w-5xl mx-auto space-y-6">
    <!-- Header & Breadcrumbs -->
    <div class="border-b border-slate-800/80 pb-5">
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-2">
        <a href="/" class="hover:text-white">Dashboard</a>
        <span>/</span>
        <a href="/subscriptions" class="hover:text-white">Subscriptions</a>
        <span>/</span>
        <span class="text-indigo-400 font-semibold">New Quotation</span>
      </nav>
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-extrabold text-white tracking-tight">Create Subscription Quotation</h1>
          <p class="text-xs text-slate-400 mt-1">Configure products, variant price modifiers (+560 Odoo brand), multi-tier discounts, and billing intervals.</p>
        </div>
      </div>
    </div>

    <!-- Quick Template Auto-Fill Banner -->
    <div class="bg-gradient-to-r from-indigo-950/60 to-slate-900 border border-indigo-900/40 rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-indigo-600/30 border border-indigo-500/40 flex items-center justify-center text-indigo-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
        </div>
        <div>
          <div class="font-bold text-xs text-white">Quotation Template Quick-Fill</div>
          <div class="text-[11px] text-slate-400">Apply a predefined enterprise bundle with automated rules.</div>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <select id="template-select" class="bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-xl px-3 py-1.5 focus:outline-none focus:border-indigo-500">
          <option value="">-- Select Template --</option>
        </select>
        <button id="btn-apply-template" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs shadow-md shadow-indigo-600/30">
          Apply
        </button>
      </div>
    </div>

    <!-- Contract Master Form -->
    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <!-- Customer Selection -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
            Customer Account <span class="text-rose-400">*</span>
          </label>
          <select id="field-customer" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="">Loading customer accounts...</option>
          </select>
        </div>

        <!-- Plan Selection -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
            Subscription Plan <span class="text-rose-400">*</span>
          </label>
          <select id="field-plan" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="">Loading plans...</option>
          </select>
        </div>

        <!-- Start Date -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
            Contract Start Date <span class="text-rose-400">*</span>
          </label>
          <input 
            type="date" 
            id="field-start-date" 
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500"
          />
        </div>

        <!-- Payment Terms -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
            Payment Terms
          </label>
          <select id="field-payment-terms" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="Immediate Payment">Immediate Payment</option>
            <option value="Net 15">Net 15 Days</option>
            <option value="Net 30" selected>Net 30 Days</option>
            <option value="Net 60">Net 60 Days</option>
          </select>
        </div>

        <!-- Promotional Discount Rule -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
            Applied Coupon / Discount Rule
          </label>
          <select id="field-discount" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="">None (Standard Pricing)</option>
          </select>
        </div>

        <!-- Notes -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">
            Contract Notes / Po Reference
          </label>
          <input 
            type="text" 
            id="field-notes" 
            placeholder="e.g. PO-2026-ALPHA approved by VP" 
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-indigo-500"
          />
        </div>
      </div>

      <!-- Line Items Section -->
      <div class="pt-4 border-t border-slate-800">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="font-bold text-white text-sm">Recurring Order Lines</h3>
            <p class="text-[11px] text-slate-400">Select product variants, Odoo branding attributes, and quantities.</p>
          </div>
          <button 
            type="button" 
            id="btn-add-line" 
            class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 text-xs font-semibold border border-indigo-500/30"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <span>Add Line Item</span>
          </button>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800">
          <table class="w-full text-left text-xs text-slate-300">
            <thead class="bg-slate-950 font-bold uppercase tracking-wider text-[10px] text-slate-400 border-b border-slate-800">
              <tr>
                <th class="py-2.5 px-3">Product</th>
                <th class="py-2.5 px-3">Variant (e.g. Odoo +560)</th>
                <th class="py-2.5 px-3 w-24">Qty</th>
                <th class="py-2.5 px-3 w-28">Unit Price</th>
                <th class="py-2.5 px-3 w-32">Subtotal</th>
                <th class="py-2.5 px-3 w-12 text-center"></th>
              </tr>
            </thead>
            <tbody id="lines-table-body" class="divide-y divide-slate-800/60 font-medium">
              <!-- Dynamically populated lines -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Financial Totals Summary Box -->
      <div class="flex justify-end pt-4">
        <div class="w-full sm:w-80 bg-slate-950 p-4 rounded-xl border border-slate-800 space-y-2 text-xs">
          <div class="flex items-center justify-between text-slate-400">
            <span>Subtotal (Recurring):</span>
            <span class="font-mono text-white font-bold" id="summary-subtotal">$0.00</span>
          </div>
          <div class="flex items-center justify-between text-slate-400">
            <span>Discount:</span>
            <span class="font-mono text-emerald-400 font-bold" id="summary-discount">-$0.00</span>
          </div>
          <div class="flex items-center justify-between text-slate-400">
            <span>Estimated Tax (18% GST):</span>
            <span class="font-mono text-white font-bold" id="summary-tax">$0.00</span>
          </div>
          <div class="border-t border-slate-800 pt-2 flex items-center justify-between text-sm">
            <span class="font-bold text-white">Total Recurring Value:</span>
            <span class="font-mono text-emerald-400 font-extrabold text-base" id="summary-total">$0.00</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800">
        <a href="/subscriptions" class="px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">
          Cancel
        </a>
        <button 
          id="btn-save-draft" 
          class="px-5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold shadow-lg shadow-indigo-600/30 flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
          <span>Create Subscription Quotation</span>
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch } from '../../lib/api';

    let catalogProducts: any[] = [];
    let catalogPlans: any[] = [];
    let discountRules: any[] = [];
    let quotationTemplates: any[] = [];
    let rowCounter = 0;

    // Set today as default start date
    const todayStr = new Date().toISOString().split('T')[0];
    const startDateInput = document.getElementById('field-start-date') as HTMLInputElement;
    if (startDateInput) startDateInput.value = todayStr;

    async function initializeCatalogData() {
      const [prodsRes, plansRes, discsRes, tmplsRes, usersRes] = await Promise.all([
        apiFetch<any>('/api/v1/catalog/products'),
        apiFetch<any>('/api/v1/catalog/plans'),
        apiFetch<any>('/api/v1/catalog/discounts'),
        apiFetch<any>('/api/v1/catalog/quotation-templates'),
        apiFetch<any>('/api/v1/auth/users'),
      ]);

      if (prodsRes.data) catalogProducts = prodsRes.data;
      if (plansRes.data) catalogPlans = plansRes.data;
      if (discsRes.data) discountRules = discsRes.data;
      if (tmplsRes.data) quotationTemplates = tmplsRes.data;

      // Populate Plans
      const planSelect = document.getElementById('field-plan');
      if (planSelect && catalogPlans.length > 0) {
        planSelect.innerHTML = catalogPlans.map(p => `
          <option value="${p.id}">${p.name} (${p.billing_interval.toUpperCase()})</option>
        `).join('');
      }

      // Populate Customers
      const custSelect = document.getElementById('field-customer');
      if (custSelect) {
        const users = usersRes.data || [
          { id: 3, full_name: 'Acmez Enterprise Customer', email: 'customer@brightloop.io' },
          { id: 1, full_name: 'Alex Morgan (Admin Account)', email: 'admin@brightloop.io' }
        ];
        custSelect.innerHTML = users.map((u: any) => `
          <option value="${u.id}">${u.full_name} (${u.email})</option>
        `).join('');
      }

      // Populate Discounts
      const discSelect = document.getElementById('field-discount');
      if (discSelect && discountRules.length > 0) {
        discSelect.innerHTML = '<option value="">None (Standard Pricing)</option>' + discountRules.map(d => `
          <option value="${d.id}">${d.code} — ${d.name} (${d.discount_type === 'percentage' ? d.value + '%' : '$' + d.value})</option>
        `).join('');
      }

      // Populate Quotation Templates
      const tmplSelect = document.getElementById('template-select');
      if (tmplSelect && quotationTemplates.length > 0) {
        tmplSelect.innerHTML = '<option value="">-- Select Template --</option>' + quotationTemplates.map(t => `
          <option value="${t.id}">${t.name} (${t.payment_terms})</option>
        `).join('');
      }

      // Add initial default line item
      addLineItem();
    }

    function addLineItem(productId?: number, variantId?: number, quantity: number = 1) {
      const tbody = document.getElementById('lines-table-body');
      if (!tbody) return;

      rowCounter++;
      const rowId = `line-row-${rowCounter}`;

      const tr = document.createElement('tr');
      tr.id = rowId;
      tr.className = 'hover:bg-slate-800/30 transition-colors line-item-row';

      const selectedProd = catalogProducts.find(p => p.id === productId) || catalogProducts[0];
      const prodOptions = catalogProducts.map(p => `
        <option value="${p.id}" ${p.id === selectedProd?.id ? 'selected' : ''}>${p.name} ($${p.base_price})</option>
      `).join('');

      tr.innerHTML = `
        <td class="py-2.5 px-3">
          <select class="line-product-select w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white focus:outline-none focus:border-indigo-500">
            ${prodOptions}
          </select>
        </td>
        <td class="py-2.5 px-3">
          <select class="line-variant-select w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white focus:outline-none focus:border-indigo-500">
            <option value="">Standard Edition</option>
          </select>
        </td>
        <td class="py-2.5 px-3">
          <input type="number" min="1" value="${quantity}" class="line-qty-input w-20 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-xs text-white font-mono text-center focus:outline-none focus:border-indigo-500" />
        </td>
        <td class="py-2.5 px-3 font-mono font-bold text-slate-200 line-unit-price">$0.00</td>
        <td class="py-2.5 px-3 font-mono font-bold text-emerald-400 line-total-price">$0.00</td>
        <td class="py-2.5 px-3 text-center">
          <button type="button" class="btn-remove-line text-slate-500 hover:text-rose-400 p-1 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </td>
      `;

      tbody.appendChild(tr);

      // Event listeners for this row
      const prodSelect = tr.querySelector('.line-product-select') as HTMLSelectElement;
      const varSelect = tr.querySelector('.line-variant-select') as HTMLSelectElement;
      const qtyInput = tr.querySelector('.line-qty-input') as HTMLInputElement;
      const removeBtn = tr.querySelector('.btn-remove-line') as HTMLButtonElement;

      function updateVariants() {
        const pId = Number(prodSelect.value);
        const prod = catalogProducts.find(p => p.id === pId);
        if (!prod || !prod.variants || prod.variants.length === 0) {
          varSelect.innerHTML = '<option value="">Standard Edition (+$0)</option>';
        } else {
          varSelect.innerHTML = '<option value="">Standard Edition (+$0)</option>' + prod.variants.map((v: any) => {
            const attrText = Object.entries(v.attributes || {}).map(([k, val]) => `${k}: ${val}`).join(', ');
            const extra = Number(v.price_extra || 0);
            return `<option value="${v.id}" ${variantId === v.id ? 'selected' : ''}>${v.sku} [${attrText}] (+${formatUSD(extra)})</option>`;
          }).join('');
        }
        calculateTotals();
      }

      prodSelect.addEventListener('change', updateVariants);
      varSelect.addEventListener('change', calculateTotals);
      qtyInput.addEventListener('input', calculateTotals);

      removeBtn.addEventListener('click', () => {
        if (document.querySelectorAll('.line-item-row').length > 1) {
          tr.remove();
          calculateTotals();
        } else {
          (window as any).showToast('Warning', 'A subscription requires at least one line item', 'warning');
        }
      });

      updateVariants();
    }

    function calculateTotals() {
      let subtotal = 0;
      const rows = document.querySelectorAll('.line-item-row');

      rows.forEach(row => {
        const pSelect = row.querySelector('.line-product-select') as HTMLSelectElement;
        const vSelect = row.querySelector('.line-variant-select') as HTMLSelectElement;
        const qInput = row.querySelector('.line-qty-input') as HTMLInputElement;
        const unitEl = row.querySelector('.line-unit-price') as HTMLElement;
        const totalEl = row.querySelector('.line-total-price') as HTMLElement;

        const prod = catalogProducts.find(p => p.id === Number(pSelect.value));
        const basePrice = Number(prod?.base_price || 0);

        let extra = 0;
        if (vSelect.value && prod?.variants) {
          const v = prod.variants.find((vr: any) => vr.id === Number(vSelect.value));
          if (v) extra = Number(v.price_extra || 0);
        }

        const effectiveUnit = basePrice + extra;
        const qty = Math.max(1, Number(qInput.value || 1));
        const lineTotal = effectiveUnit * qty;

        unitEl.textContent = formatUSD(effectiveUnit);
        totalEl.textContent = formatUSD(lineTotal);
        subtotal += lineTotal;
      });

      // Discount
      let discountAmount = 0;
      const discSelect = document.getElementById('field-discount') as HTMLSelectElement;
      if (discSelect.value) {
        const disc = discountRules.find(d => d.id === Number(discSelect.value));
        if (disc) {
          if (disc.discount_type === 'percentage') {
            discountAmount = subtotal * (Number(disc.value) / 100);
          } else {
            discountAmount = Math.min(subtotal, Number(disc.value));
          }
        }
      }

      const taxableBase = Math.max(0, subtotal - discountAmount);
      const taxAmount = taxableBase * 0.18; // 18% GST standard
      const finalTotal = taxableBase + taxAmount;

      document.getElementById('summary-subtotal')!.textContent = formatUSD(subtotal);
      document.getElementById('summary-discount')!.textContent = `-${formatUSD(discountAmount)}`;
      document.getElementById('summary-tax')!.textContent = formatUSD(taxAmount);
      document.getElementById('summary-total')!.textContent = formatUSD(finalTotal);
    }

    function formatUSD(val: number): string {
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(val);
    }

    // Add Line Button
    document.getElementById('btn-add-line')?.addEventListener('click', () => addLineItem());

    // Discount change recalculates totals
    document.getElementById('field-discount')?.addEventListener('change', calculateTotals);

    // Apply Quotation Template
    document.getElementById('btn-apply-template')?.addEventListener('click', async () => {
      const tmplSelect = document.getElementById('template-select') as HTMLSelectElement;
      const tmplId = Number(tmplSelect.value);
      if (!tmplId) return;

      const tmpl = quotationTemplates.find(t => t.id === tmplId);
      if (!tmpl) return;

      // Set plan
      const planSelect = document.getElementById('field-plan') as HTMLSelectElement;
      if (planSelect && tmpl.plan_id) planSelect.value = String(tmpl.plan_id);

      // Set payment terms
      const ptSelect = document.getElementById('field-payment-terms') as HTMLSelectElement;
      if (ptSelect && tmpl.payment_terms) ptSelect.value = tmpl.payment_terms;

      // Clear existing lines and populate from template
      const tbody = document.getElementById('lines-table-body');
      if (tbody) tbody.innerHTML = '';

      if (tmpl.template_lines && tmpl.template_lines.length > 0) {
        tmpl.template_lines.forEach((tl: any) => {
          addLineItem(tl.product_id, tl.variant_id, tl.quantity);
        });
      } else {
        addLineItem();
      }

      (window as any).showToast('Template Applied', `Populated ${tmpl.name}`, 'success');
      calculateTotals();
    });

    // Form Submission
    document.getElementById('btn-save-draft')?.addEventListener('click', async () => {
      const custSelect = document.getElementById('field-customer') as HTMLSelectElement;
      const planSelect = document.getElementById('field-plan') as HTMLSelectElement;
      const startDateInput = document.getElementById('field-start-date') as HTMLInputElement;
      const ptSelect = document.getElementById('field-payment-terms') as HTMLSelectElement;
      const discSelect = document.getElementById('field-discount') as HTMLSelectElement;
      const notesInput = document.getElementById('field-notes') as HTMLInputElement;

      const customerId = Number(custSelect.value);
      const planId = Number(planSelect.value);
      const startDate = startDateInput.value;

      if (!customerId || !planId || !startDate) {
        (window as any).showToast('Validation Error', 'Please specify Customer, Plan, and Start Date', 'error');
        return;
      }

      const lines: any[] = [];
      document.querySelectorAll('.line-item-row').forEach(row => {
        const pSelect = row.querySelector('.line-product-select') as HTMLSelectElement;
        const vSelect = row.querySelector('.line-variant-select') as HTMLSelectElement;
        const qInput = row.querySelector('.line-qty-input') as HTMLInputElement;

        lines.push({
          product_id: Number(pSelect.value),
          variant_id: vSelect.value ? Number(vSelect.value) : null,
          quantity: Math.max(1, Number(qInput.value || 1)),
          description: '',
        });
      });

      const payload = {
        customer_id: customerId,
        plan_id: planId,
        start_date: startDate,
        payment_terms: ptSelect.value,
        applied_discount_id: discSelect.value ? Number(discSelect.value) : null,
        notes: notesInput.value || null,
        lines,
      };

      const btn = document.getElementById('btn-save-draft') as HTMLButtonElement;
      btn.disabled = true;
      btn.innerHTML = '<span>Creating Contract...</span>';

      const res = await apiFetch<any>('/api/v1/subscriptions', {
        method: 'POST',
        body: JSON.stringify(payload),
      });

      if (res.data?.id) {
        (window as any).showToast('Quotation Created', `Subscription ${res.data.subscription_number} saved as Draft`, 'success');
        setTimeout(() => {
          window.location.href = `/subscriptions/${res.data.id}`;
        }, 600);
      } else {
        btn.disabled = false;
        btn.innerHTML = '<span>Create Subscription Quotation</span>';
        (window as any).showToast('Creation Failed', res.error || 'Server error', 'error');
      }
    });

    initializeCatalogData();
  </script>
</Layout>
