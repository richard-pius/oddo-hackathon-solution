---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Subscriptions — Brightloop ERP" activeNav="subscriptions" breadcrumbs={[{ label: 'Brightloop ERP', href: '/' }, { label: 'Subscriptions' }]}>
  <div class="space-y-4">
    
    <!-- Top Action Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div>
        <h1 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
          <span>Subscriptions Management</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200" id="total-badge">
            ... Contracts
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Full recurring lifecycle contracts with Odoo state machines, proration, and automated billing.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a 
          href="/subscriptions/new" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold transition-colors shadow-xs"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Create Subscription</span>
        </a>
      </div>
    </div>

    <!-- Filter Pipeline & Search Bar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white p-2.5 rounded-md border border-slate-200 shadow-2xs">
      <!-- Status Tabs -->
      <div class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0" id="filter-tabs">
        <button class="status-tab-btn active px-2.5 py-1 rounded text-xs font-semibold bg-[#714B67] text-white transition-colors" data-status="">
          All Subscriptions
        </button>
        <button class="status-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="quotation">
          Quotations
        </button>
        <button class="status-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="confirmed">
          Confirmed
        </button>
        <button class="status-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="active">
          Active
        </button>
        <button class="status-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="paused">
          Paused
        </button>
        <button class="status-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="closed">
          Closed
        </button>
      </div>

      <!-- Search Input -->
      <div class="relative w-full sm:w-60">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Filter contracts..." 
          class="w-full bg-slate-50 border border-slate-300 rounded px-2.5 py-1 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#714B67] focus:border-[#714B67]"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- High-Density Subscriptions Table -->
    <div class="bg-white border border-slate-200 rounded-md shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="erp-table">
          <thead>
            <tr>
              <th>Contract #</th>
              <th>Customer</th>
              <th>Plan</th>
              <th>Interval</th>
              <th>Start Date</th>
              <th>Next Billing</th>
              <th>Recurring Total</th>
              <th>State</th>
              <th class="text-right">Action</th>
            </tr>
          </thead>
          <tbody id="subscriptions-table">
            <tr>
              <td colspan="9" class="py-8 text-center text-slate-400 text-xs">Loading subscriptions list...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Footer Info & Cursor Pagination -->
      <div class="p-3 border-t border-slate-200 bg-slate-50/50 flex items-center justify-between text-xs text-slate-500">
        <span id="page-info">Showing subscriptions</span>
        <div class="flex items-center gap-1.5">
          <button id="btn-prev-page" class="px-2.5 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium disabled:opacity-40" disabled>Previous</button>
          <button id="btn-next-page" class="px-2.5 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium disabled:opacity-40" disabled>Next</button>
        </div>
      </div>
    </div>

  </div>

  <script>
    import { apiFetch } from '../../lib/api';

    let currentStatus = '';
    let searchQuery = '';
    let cursor = 0;
    const limit = 25;

    async function fetchSubscriptions() {
      const table = document.getElementById('subscriptions-table');
      if (table) {
        table.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-slate-400 text-xs">Loading subscriptions...</td></tr>';
      }

      let url = `/api/v1/subscriptions/?limit=${limit}`;
      if (cursor > 0) url += `&cursor=${cursor}`;
      if (currentStatus) url += `&status_filter=${currentStatus}`;

      const res = await apiFetch<any>(url);
      if (!res.data || !res.data.items) {
        if (table) table.innerHTML = `<tr><td colspan="9" class="py-6 text-center text-rose-600 text-xs">Error: ${res.error || 'Failed to load'}</td></tr>`;
        return;
      }

      const totalBadge = document.getElementById('total-badge');
      const pageInfo = document.getElementById('page-info');
      const nextBtn = document.getElementById('btn-next-page') as HTMLButtonElement;

      if (totalBadge) totalBadge.textContent = `${res.data.items.length} Contracts`;
      if (pageInfo) pageInfo.textContent = `Displaying ${res.data.items.length} records`;
      if (nextBtn) nextBtn.disabled = !res.data.has_more;

      if (table) {
        if (res.data.items.length === 0) {
          table.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-slate-400 text-xs">No subscriptions matched your filter criteria.</td></tr>';
          return;
        }

        table.innerHTML = res.data.items.map((sub: any) => `
          <tr>
            <td class="font-mono font-bold text-slate-900">
              <a href="/subscriptions/${sub.id}" class="hover:text-[#714B67] underline decoration-slate-300">
                ${sub.subscription_number}
              </a>
            </td>
            <td>
              <div class="font-medium text-slate-900">${sub.customer_name || 'Customer #' + sub.customer_id}</div>
              <div class="text-[10px] text-slate-400 font-mono">${sub.customer_email || ''}</div>
            </td>
            <td>
              <span class="px-1.5 py-0.5 rounded text-[11px] bg-slate-100 text-slate-700 font-mono border border-slate-200">${sub.plan_name || 'Standard'}</span>
            </td>
            <td class="capitalize font-mono text-slate-600 text-xs">${sub.billing_interval || 'Month'}</td>
            <td class="font-mono text-slate-600 text-xs">${sub.start_date || 'N/A'}</td>
            <td class="font-mono font-semibold text-slate-900 text-xs">${sub.next_billing_date || 'N/A'}</td>
            <td class="font-mono font-bold text-slate-900">${formatUSD(sub.total_recurring)}</td>
            <td>
              ${getStatusBadge(sub.status)}
            </td>
            <td class="text-right">
              <a 
                href="/subscriptions/${sub.id}" 
                class="px-2 py-0.5 rounded bg-white hover:bg-slate-50 text-[#714B67] text-xs font-semibold border border-slate-300 shadow-2xs"
              >
                Form View
              </a>
            </td>
          </tr>
        `).join('');
      }
    }

    function formatUSD(val: number | string | null | undefined): string {
      const num = Number(val || 0);
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
    }

    function getStatusBadge(status: string): string {
      const map: Record<string, string> = {
        draft: 'bg-slate-100 text-slate-600 border-slate-200',
        quotation: 'bg-amber-50 text-amber-700 border-amber-200',
        confirmed: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        active: 'bg-emerald-50 text-emerald-700 border-emerald-200',
        paused: 'bg-sky-50 text-sky-700 border-sky-200',
        cancelled: 'bg-rose-50 text-rose-700 border-rose-200',
        closed: 'bg-slate-100 text-slate-600 border-slate-200',
      };
      const cls = map[status.toLowerCase()] || map.draft;
      return `<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${cls}">${status}</span>`;
    }

    // Filter tabs click
    document.querySelectorAll('.status-tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.status-tab-btn').forEach(b => {
          b.classList.remove('bg-[#714B67]', 'text-white', 'active');
          b.classList.add('text-slate-600');
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add('bg-[#714B67]', 'text-white', 'active');
        target.classList.remove('text-slate-600');

        currentStatus = target.dataset.status || '';
        cursor = 0;
        fetchSubscriptions();
      });
    });

    // Pagination
    document.getElementById('btn-next-page')?.addEventListener('click', () => {
      // Advance cursor
      fetchSubscriptions();
    });

    fetchSubscriptions();
  </script>
</Layout>
