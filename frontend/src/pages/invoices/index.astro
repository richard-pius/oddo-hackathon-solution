---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Invoices & Billing — Brightloop ERP" activeNav="invoices" breadcrumbs={[{ label: 'Brightloop ERP', href: '/' }, { label: 'Invoices' }]}>
  <div class="space-y-4">
    
    <!-- Top Action Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div>
        <h1 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
          <span>Invoices & Billing Ledger</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-slate-100 text-slate-700 border border-slate-200" id="invoices-count-badge">
            ... Invoices
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Idempotent recurring billing, ReportLab vector PDF generation, dunning aging reports, and payment reconciliation.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          id="btn-open-generate-inv-modal" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors shadow-2xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-[#714B67]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Generate Invoice</span>
        </button>
        <button 
          id="btn-trigger-batch-billing-page" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold transition-colors shadow-xs"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
          <span>Run Nightly Billing Batch</span>
        </button>
      </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white p-2.5 rounded-md border border-slate-200 shadow-2xs">
      <div class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0" id="inv-status-tabs">
        <button class="inv-tab-btn active px-2.5 py-1 rounded text-xs font-semibold bg-[#714B67] text-white transition-colors" data-status="">
          All Invoices
        </button>
        <button class="inv-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="confirmed">
          Posted / Due
        </button>
        <button class="inv-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="paid">
          Paid
        </button>
        <button class="inv-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="overdue">
          Overdue Aging
        </button>
        <button class="inv-tab-btn px-2.5 py-1 rounded text-xs font-semibold text-slate-600 hover:bg-slate-100 transition-colors" data-status="draft">
          Draft
        </button>
      </div>

      <div class="relative w-full sm:w-60">
        <input 
          type="text" 
          id="inv-search" 
          placeholder="Filter invoices..." 
          class="w-full bg-slate-50 border border-slate-300 rounded px-2.5 py-1 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#714B67]"
        />
        <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
    </div>

    <!-- Invoices Table Grid -->
    <div class="bg-white border border-slate-200 rounded-md shadow-xs overflow-hidden">
      <div class="overflow-x-auto">
        <table class="erp-table">
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Customer</th>
              <th>Subscription</th>
              <th>Issue Date</th>
              <th>Due Date</th>
              <th>Total Amount</th>
              <th>Due Balance</th>
              <th>Status</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody id="invoices-table">
            <tr>
              <td colspan="9" class="py-8 text-center text-slate-400 text-xs">Loading invoices ledger...</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="p-3 border-t border-slate-200 bg-slate-50/50 flex items-center justify-between text-xs text-slate-500">
        <span id="inv-page-info">Showing invoices</span>
        <div class="flex items-center gap-1.5">
          <button id="inv-prev" class="px-2.5 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium disabled:opacity-40" disabled>Previous</button>
          <button id="inv-next" class="px-2.5 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium disabled:opacity-40" disabled>Next</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Record Payment Modal -->
  <div id="payment-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-md p-5 max-w-md w-full shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Record Payment</h3>
          <p class="text-xs text-slate-500">Auto-reconciles invoice when balance hits $0.00</p>
        </div>
        <button id="btn-close-payment-modal" class="text-slate-400 hover:text-slate-600 p-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="space-y-3 text-xs">
        <div class="bg-slate-50 p-2.5 rounded border border-slate-200">
          <div class="flex justify-between text-slate-600 mb-0.5">
            <span>Invoice:</span>
            <span class="font-mono text-slate-900 font-bold" id="pay-inv-number">INV-...</span>
          </div>
          <div class="flex justify-between text-slate-600">
            <span>Outstanding Balance:</span>
            <span class="font-mono text-amber-700 font-bold" id="pay-inv-balance">$0.00</span>
          </div>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Payment Amount ($)</label>
          <input 
            type="number" 
            step="0.01" 
            id="pay-amount" 
            class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 font-mono text-slate-900 text-sm font-bold focus:outline-none focus:ring-1 focus:ring-[#714B67]" 
          />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Payment Method</label>
          <select id="pay-method" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="credit_card">Credit Card (Stripe Gateway)</option>
            <option value="bank_transfer">Wire / ACH Bank Transfer</option>
            <option value="stripe">Stripe Checkout / Webhook</option>
            <option value="upi">UPI Real-Time Transfer</option>
            <option value="cash">Direct Cash / Cheque</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Payment Reference / Transaction ID</label>
          <input 
            type="text" 
            id="pay-reference" 
            placeholder="e.g. TXN-STRIPE-89123 or Wire Ref #4412" 
            class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#714B67]" 
          />
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-pay" class="px-3 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium">
          Cancel
        </button>
        <button id="btn-submit-payment" class="px-3.5 py-1 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs">
          Reconcile Payment
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch, API_URL } from '../../lib/api';

    let currentStatus = '';
    let searchQuery = '';
    let cursor = 0;
    const limit = 25;
    let selectedInvoiceForPayment: any = null;

    async function fetchInvoices() {
      const table = document.getElementById('invoices-table');
      if (table) {
        table.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-slate-400 text-xs">Loading invoices...</td></tr>';
      }

      let url = `/api/v1/billing/invoices?limit=${limit}`;
      if (cursor > 0) url += `&cursor=${cursor}`;
      if (currentStatus) url += `&status_filter=${currentStatus}`;

      const res = await apiFetch<any>(url);
      if (!res.data || !res.data.items) {
        if (table) table.innerHTML = `<tr><td colspan="9" class="py-6 text-center text-rose-600 text-xs">Error: ${res.error || 'Failed to load'}</td></tr>`;
        return;
      }

      const totalBadge = document.getElementById('invoices-count-badge');
      const pageInfo = document.getElementById('inv-page-info');
      const nextBtn = document.getElementById('inv-next') as HTMLButtonElement;

      if (totalBadge) totalBadge.textContent = `${res.data.items.length} Invoices`;
      if (pageInfo) pageInfo.textContent = `Displaying ${res.data.items.length} records`;
      if (nextBtn) nextBtn.disabled = !res.data.has_more;

      if (table) {
        if (res.data.items.length === 0) {
          table.innerHTML = '<tr><td colspan="9" class="py-8 text-center text-slate-400 text-xs">No invoices match criteria.</td></tr>';
          return;
        }

        table.innerHTML = res.data.items.map((inv: any) => `
          <tr>
            <td class="font-mono font-bold text-slate-900">
              <a href="/invoices/${inv.id}" class="hover:text-[#714B67] underline decoration-slate-300">
                ${inv.invoice_number}
              </a>
            </td>
            <td class="font-medium text-slate-800">${inv.customer_name || 'Customer #' + inv.customer_id}</td>
            <td class="font-mono text-slate-600 text-xs">
              <a href="/subscriptions/${inv.subscription_id}" class="hover:underline">
                ${inv.subscription_number || '#' + inv.subscription_id}
              </a>
            </td>
            <td class="font-mono text-slate-600 text-xs">${inv.issue_date}</td>
            <td class="font-mono text-slate-600 text-xs">${inv.due_date}</td>
            <td class="font-mono font-bold text-slate-900">${formatUSD(inv.total_amount)}</td>
            <td class="font-mono font-bold ${inv.amount_due > 0 ? 'text-amber-700' : 'text-slate-500'}">${formatUSD(inv.amount_due)}</td>
            <td>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${getInvoiceClass(inv.status)}">
                ${inv.status}
              </span>
            </td>
            <td class="text-right">
              <div class="inline-flex items-center gap-1.5">
                <a 
                  href="${API_URL}/api/v1/billing/invoices/${inv.id}/pdf?token=" + encodeURIComponent(localStorage.getItem("brightloop_token") || "") 
                  target="_blank" 
                  class="px-2 py-0.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-medium text-[11px] shadow-2xs" 
                  title="Download Official ReportLab PDF"
                >
                  PDF
                </a>
                ${inv.status !== 'paid' ? `
                  <button 
                    class="btn-open-pay px-2 py-0.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white font-semibold text-[11px] shadow-2xs"
                    data-inv='${JSON.stringify(inv)}'
                  >
                    Pay
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `).join('');

        // Attach pay button listeners
        document.querySelectorAll('.btn-open-pay').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const raw = (e.currentTarget as HTMLElement).dataset.inv!;
            openPaymentModal(JSON.parse(raw));
          });
        });
      }
    }

    function openPaymentModal(inv: any) {
      selectedInvoiceForPayment = inv;
      const modal = document.getElementById('payment-modal')!;
      document.getElementById('pay-inv-number')!.textContent = inv.invoice_number;
      document.getElementById('pay-inv-balance')!.textContent = formatUSD(inv.amount_due);
      (document.getElementById('pay-amount') as HTMLInputElement).value = String(inv.amount_due);
      modal.classList.remove('hidden');
    }

    document.getElementById('btn-close-payment-modal')?.addEventListener('click', () => {
      document.getElementById('payment-modal')?.classList.add('hidden');
    });
    document.getElementById('btn-cancel-pay')?.addEventListener('click', () => {
      document.getElementById('payment-modal')?.classList.add('hidden');
    });

    document.getElementById('btn-submit-payment')?.addEventListener('click', async () => {
      if (!selectedInvoiceForPayment) return;
      const amount = Number((document.getElementById('pay-amount') as HTMLInputElement).value);
      const method = (document.getElementById('pay-method') as HTMLSelectElement).value;
      const ref = (document.getElementById('pay-reference') as HTMLInputElement).value;

      const res = await apiFetch<any>('/api/v1/payments/', {
        method: 'POST',
        body: JSON.stringify({
          invoice_id: selectedInvoiceForPayment.id,
          amount: amount,
          payment_method: method,
          reference_note: ref || 'Manual ERP Settlement',
        }),
      });

      if (res.data) {
        document.getElementById('payment-modal')?.classList.add('hidden');
        alert(`✅ Payment recorded for ${selectedInvoiceForPayment.invoice_number}`);
        fetchInvoices();
      } else {
        alert(res.error || 'Payment failed');
      }
    });

    function formatUSD(val: number | string | null | undefined): string {
      const num = Number(val || 0);
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
    }

    function getInvoiceClass(status: string): string {
      const map: Record<string, string> = {
        draft: 'bg-slate-100 text-slate-600 border-slate-200',
        confirmed: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        posted: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        paid: 'bg-emerald-50 text-emerald-700 border-emerald-200',
        partially_paid: 'bg-amber-50 text-amber-700 border-amber-200',
        overdue: 'bg-rose-50 text-rose-700 border-rose-200',
        cancelled: 'bg-slate-100 text-slate-600 border-slate-200',
      };
      return map[status?.toLowerCase()] || map.draft;
    }

    // Tabs
    document.querySelectorAll('.inv-tab-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.inv-tab-btn').forEach(b => {
          b.classList.remove('bg-[#714B67]', 'text-white', 'active');
          b.classList.add('text-slate-600');
        });
        const target = e.currentTarget as HTMLElement;
        target.classList.add('bg-[#714B67]', 'text-white', 'active');
        target.classList.remove('text-slate-600');

        currentStatus = target.dataset.status || '';
        cursor = 0;
        fetchInvoices();
      });
    });

    document.getElementById('btn-trigger-batch-billing-page')?.addEventListener('click', async () => {
      const res = await apiFetch<any>('/api/v1/billing/run-billing', { method: 'POST' });
      if (res.data) {
        alert(`✅ Batch billing complete!\nInvoices generated: ${res.data.invoices_generated || 0}`);
        fetchInvoices();
      }
    });

    fetchInvoices();
  
    // Generate Invoice Modal Logic
    const genModal = document.getElementById('modal-generate-invoice');
    const genSubSelect = document.getElementById('gen-inv-sub-select') as HTMLSelectElement;

    document.getElementById('btn-open-generate-inv-modal')?.addEventListener('click', async () => {
      genModal?.classList.remove('hidden');
      if (genSubSelect) {
        genSubSelect.innerHTML = '<option value="">Loading active subscriptions...</option>';
        const res = await apiFetch<any>('/api/v1/subscriptions?status_filter=ACTIVE');
        if (res.data?.items && res.data.items.length > 0) {
          genSubSelect.innerHTML = res.data.items.map((s: any) => `
            <option value="${s.id}">
              ${s.subscription_number} — ${s.customer_name || 'Customer #' + s.customer_id} (${formatUSD(s.total_recurring)}/mo)
            </option>
          `).join('');
        } else {
          genSubSelect.innerHTML = '<option value="">No active subscriptions found</option>';
        }
      }
    });

    document.getElementById('btn-close-gen-inv-modal')?.addEventListener('click', () => genModal?.classList.add('hidden'));
    document.getElementById('btn-cancel-gen-inv')?.addEventListener('click', () => genModal?.classList.add('hidden'));

    document.getElementById('btn-submit-gen-inv')?.addEventListener('click', async () => {
      const subId = Number(genSubSelect?.value);
      if (!subId) {
        alert('Please select an active subscription');
        return;
      }

      const res = await apiFetch<any>(`/api/v1/subscriptions/${subId}/generate-invoice`, {
        method: 'POST',
      });

      if (res.data) {
        genModal?.classList.add('hidden');
        alert(`✅ Invoice generated: ${res.data.invoice_number} ($${Number(res.data.total_amount).toFixed(2)})`);
        fetchInvoices();
      } else {
        alert(res.error || 'Failed to generate invoice');
      }
    });
</script>

  <!-- Generate Invoice Modal -->
  <div id="modal-generate-invoice" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-md p-5 max-w-md w-full shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Generate Subscription Invoice</h3>
          <p class="text-xs text-slate-500">Create an on-demand billing cycle invoice</p>
        </div>
        <button id="btn-close-gen-inv-modal" class="text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Target Active Subscription</label>
          <select id="gen-inv-sub-select" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="">Loading subscriptions...</option>
          </select>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-gen-inv" class="px-3 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium cursor-pointer">
          Cancel
        </button>
        <button id="btn-submit-gen-inv" class="px-3.5 py-1 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs cursor-pointer">
          Generate & Post Invoice
        </button>
      </div>
    </div>
  </div>
</Layout>
