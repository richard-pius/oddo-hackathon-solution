---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { id: '1' } },
    { params: { id: '2' } },
    { params: { id: '3' } },
    { params: { id: '4' } },
    { params: { id: '5' } },
    { params: { id: '6' } },
  ];
}

const { id } = Astro.params;
---

<Layout title="Invoice Details — Brightloop ERP" activeNav="invoices" breadcrumbs={[{ label: 'Brightloop ERP', href: '/' }, { label: 'Invoices', href: '/invoices' }, { label: 'Invoice Document' }]}>
  <div class="max-w-4xl mx-auto space-y-4">
    
    <!-- Top Action Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div class="flex items-center gap-2">
        <h1 class="text-xl font-bold font-mono text-slate-900 tracking-tight" id="inv-doc-title">INV-...</h1>
        <div id="inv-status-pill">
          <!-- Status pill injected -->
        </div>
      </div>

      <div class="flex items-center gap-2">
        <a 
          id="btn-download-pdf" 
          href="#" 
          target="_blank" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs"
        >
          <svg class="w-3.5 h-3.5 text-[#714B67]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span>Download Official PDF</span>
        </a>

        <button 
          id="btn-trigger-pay" 
          class="hidden items-center gap-1.5 px-3 py-1.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <span>Record Payment</span>
        </button>
      </div>
    </div>

    <!-- Official ERP Invoice Document Sheet -->
    <div class="bg-white border border-slate-200 rounded-md p-8 shadow-xs space-y-6 relative overflow-hidden">
      
      <!-- PAID Watermark Stamp -->
      <div id="stamp-paid" class="hidden absolute top-8 right-8 border-2 border-emerald-600 text-emerald-700 font-bold text-xl uppercase tracking-widest px-4 py-1 rounded rotate-12 select-none">
        PAID
      </div>

      <!-- Invoice Header: Brightloop + Invoice # -->
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6 border-b border-slate-200 pb-5">
        <div>
          <div class="flex items-center gap-2.5 mb-1.5">
            <div class="w-7 h-7 rounded bg-[#714B67] flex items-center justify-center font-bold text-white text-xs">
              BL
            </div>
            <span class="font-bold text-lg text-slate-900 tracking-tight">Brightloop Software</span>
          </div>
          <div class="text-xs text-slate-500 leading-relaxed font-mono">
            Recurring Billing & Cloud Infrastructure<br>
            GST Jurisdiction: IN-18% Standard<br>
            billing@brightloop.io
          </div>
        </div>

        <div class="text-left sm:text-right">
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-400">Tax Invoice</div>
          <div class="text-2xl font-bold text-slate-900 font-mono mt-0.5" id="inv-doc-number">INV-...</div>
        </div>
      </div>

      <!-- Parties & Metadata Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="bg-slate-50 p-3.5 rounded border border-slate-200 space-y-1">
          <div class="font-semibold uppercase tracking-wider text-slate-400 text-[10px]">Billed To (Customer Account):</div>
          <div class="font-bold text-slate-900 text-sm" id="cust-name">...</div>
          <div class="text-slate-500 font-mono" id="cust-email">...</div>
        </div>

        <div class="bg-slate-50 p-3.5 rounded border border-slate-200 space-y-1.5 font-mono text-xs">
          <div class="flex justify-between">
            <span class="text-slate-500 font-sans">Issue Date:</span>
            <span class="text-slate-900 font-semibold" id="inv-issue-date">...</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 font-sans">Due Date:</span>
            <span class="text-amber-800 font-bold" id="inv-due-date">...</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 font-sans">Billing Period:</span>
            <span class="text-slate-700" id="inv-period">...</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 font-sans">Contract Reference:</span>
            <span class="text-[#714B67] font-semibold" id="inv-sub-link">...</span>
          </div>
        </div>
      </div>

      <!-- Itemized Line Items Table -->
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Itemized Charges</div>
        <div class="overflow-x-auto border border-slate-200 rounded">
          <table class="erp-table">
            <thead>
              <tr>
                <th>Description</th>
                <th class="w-20 text-center">Qty</th>
                <th class="w-28">Unit Price</th>
                <th class="w-24">Discount</th>
                <th class="w-24">Tax</th>
                <th class="w-32 text-right">Amount</th>
              </tr>
            </thead>
            <tbody id="inv-lines-table">
              <!-- Injected -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Totals Summary & Balance Due -->
      <div class="flex justify-end pt-1">
        <div class="w-72 bg-slate-50 p-4 rounded border border-slate-200 space-y-2 text-xs font-mono">
          <div class="flex justify-between text-slate-600">
            <span>Subtotal:</span>
            <span class="text-slate-900 font-bold" id="tot-subtotal">$0.00</span>
          </div>
          <div class="flex justify-between text-slate-600">
            <span>Discount:</span>
            <span class="text-emerald-700 font-bold" id="tot-discount">-$0.00</span>
          </div>
          <div class="flex justify-between text-slate-600">
            <span>Taxes (18% GST):</span>
            <span class="text-slate-900 font-bold" id="tot-tax">$0.00</span>
          </div>
          <div class="border-t border-slate-200 pt-1.5 flex justify-between text-sm">
            <span class="font-bold text-slate-900 font-sans">Total Amount:</span>
            <span class="text-slate-900 font-extrabold" id="tot-total">$0.00</span>
          </div>
          <div class="flex justify-between text-slate-600">
            <span>Paid to Date:</span>
            <span class="text-emerald-700 font-bold" id="tot-paid">$0.00</span>
          </div>
          <div class="border-t border-slate-200 pt-1.5 flex justify-between text-sm">
            <span class="font-bold text-slate-900 font-sans">Amount Due:</span>
            <span class="text-amber-800 font-black text-base" id="tot-due">$0.00</span>
          </div>
        </div>
      </div>

      <!-- Reconciled Payment Transactions -->
      <div class="pt-4 border-t border-slate-100">
        <div class="text-xs font-semibold uppercase tracking-wider text-slate-500 mb-2">Reconciled Payment Transactions</div>
        <div id="payments-list" class="space-y-1.5">
          <div class="text-xs text-slate-400 italic">No payments recorded against this invoice yet.</div>
        </div>
      </div>

    </div>

  </div>

  <!-- Record Payment Modal -->
  <div id="pay-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-md p-5 max-w-md w-full shadow-lg space-y-3">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2">
        <h3 class="font-bold text-slate-900 text-sm">Record Payment</h3>
        <button id="btn-close-pay-modal" class="text-slate-400 hover:text-slate-600 p-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="space-y-2.5 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Amount ($)</label>
          <input type="number" step="0.01" id="input-pay-amount" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 font-mono text-slate-900 text-sm font-bold focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Payment Method</label>
          <select id="select-pay-method" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="credit_card">Credit Card (Stripe Gateway)</option>
            <option value="bank_transfer">Wire / ACH Bank Transfer</option>
            <option value="stripe">Stripe Checkout / Webhook</option>
            <option value="upi">UPI Real-Time Transfer</option>
            <option value="cash">Direct Cash / Cheque</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Reference / Note</label>
          <input type="text" id="input-pay-ref" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-pay-modal" class="px-3 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium">
          Cancel
        </button>
        <button id="btn-confirm-pay" class="px-3.5 py-1 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs">
          Confirm Payment
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch, API_URL } from '../../lib/api';

    const parts = window.location.pathname.split('/');
    const invId = Number(parts[parts.length - 1] || parts[parts.length - 2]);

    let invoiceData: any = null;

    async function loadInvoiceDetails() {
      if (!invId || isNaN(invId)) return;

      const [invRes, paysRes] = await Promise.all([
        apiFetch<any>(`/api/v1/billing/invoices/${invId}`),
        apiFetch<any>(`/api/v1/payments?invoice_id=${invId}`),
      ]);

      if (!invRes.data) {
        alert(invRes.error || 'Invoice not found');
        return;
      }

      invoiceData = invRes.data;
      renderInvoice(invRes.data);
      renderPayments(paysRes.data?.items || []);
    }

    function renderInvoice(inv: any) {
      document.getElementById('inv-doc-title')!.textContent = inv.invoice_number;
      document.getElementById('inv-doc-number')!.textContent = inv.invoice_number;
      document.getElementById('cust-name')!.textContent = inv.customer_name || `Customer #${inv.customer_id}`;
      document.getElementById('cust-email')!.textContent = inv.customer_email || '';
      document.getElementById('inv-issue-date')!.textContent = inv.issue_date;
      document.getElementById('inv-due-date')!.textContent = inv.due_date;
      document.getElementById('inv-period')!.textContent = `${inv.billing_period_start || ''} — ${inv.billing_period_end || ''}`;
      
      const subLink = document.getElementById('inv-sub-link')!;
      if (inv.subscription_id) {
        subLink.innerHTML = `<a href="/subscriptions/${inv.subscription_id}" class="hover:underline">${inv.subscription_number || '#' + inv.subscription_id}</a>`;
      } else {
        subLink.textContent = 'None';
      }

      // Status pill & PDF button
      const pill = document.getElementById('inv-status-pill')!;
      pill.innerHTML = `<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${getInvoiceClass(inv.status)}">${inv.status}</span>`;

      const pdfBtn = document.getElementById('btn-download-pdf') as HTMLAnchorElement;
      pdfBtn.href = `${API_URL}/api/v1/billing/invoices/${inv.id}/pdf`;

      // Paid stamp
      const stampPaid = document.getElementById('stamp-paid')!;
      if (inv.status === 'paid') {
        stampPaid.classList.remove('hidden');
      } else {
        stampPaid.classList.add('hidden');
      }

      // Payment button
      const payBtn = document.getElementById('btn-trigger-pay')!;
      if (inv.status !== 'paid' && inv.status !== 'cancelled') {
        payBtn.classList.remove('hidden');
        payBtn.classList.add('inline-flex');
      } else {
        payBtn.classList.add('hidden');
      }

      // Render lines
      const tbody = document.getElementById('inv-lines-table')!;
      const lines = inv.lines || [];
      if (lines.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-slate-400 text-xs">No line items recorded.</td></tr>';
      } else {
        tbody.innerHTML = lines.map((l: any) => `
          <tr>
            <td class="font-medium text-slate-900">${l.description}</td>
            <td class="font-mono text-center text-slate-800">${l.quantity}</td>
            <td class="font-mono text-slate-700">${formatUSD(l.unit_price)}</td>
            <td class="font-mono text-emerald-700">-${formatUSD(l.discount_amount || 0)}</td>
            <td class="font-mono text-slate-600">${formatUSD(l.tax_amount || 0)}</td>
            <td class="font-mono font-bold text-slate-900 text-right">${formatUSD(l.total_amount)}</td>
          </tr>
        `).join('');
      }

      document.getElementById('tot-subtotal')!.textContent = formatUSD(inv.subtotal || 0);
      document.getElementById('tot-discount')!.textContent = `-${formatUSD(inv.discount_total || 0)}`;
      document.getElementById('tot-tax')!.textContent = formatUSD(inv.tax_total || 0);
      document.getElementById('tot-total')!.textContent = formatUSD(inv.total_amount || 0);
      document.getElementById('tot-paid')!.textContent = formatUSD(inv.amount_paid || 0);
      document.getElementById('tot-due')!.textContent = formatUSD(inv.amount_due || 0);
    }

    function renderPayments(payments: any[]) {
      const list = document.getElementById('payments-list')!;
      if (payments.length === 0) {
        list.innerHTML = '<div class="text-xs text-slate-400 italic">No payments recorded against this invoice yet.</div>';
      } else {
        list.innerHTML = payments.map((p: any) => `
          <div class="flex items-center justify-between p-2 rounded bg-slate-50 border border-slate-200 text-xs">
            <div class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              <span class="font-mono font-semibold text-slate-900">${p.payment_number || 'TXN-' + p.id}</span>
              <span class="text-slate-500 font-mono text-[10px]">${p.payment_date}</span>
              <span class="px-1.5 py-0.2 rounded text-[10px] bg-slate-200 text-slate-700 font-mono capitalize">${p.payment_method}</span>
            </div>
            <div class="font-mono font-bold text-emerald-700">+${formatUSD(p.amount)}</div>
          </div>
        `).join('');
      }
    }

    // Modal
    const payModal = document.getElementById('pay-modal')!;
    document.getElementById('btn-trigger-pay')?.addEventListener('click', () => {
      if (!invoiceData) return;
      (document.getElementById('input-pay-amount') as HTMLInputElement).value = String(invoiceData.amount_due);
      payModal.classList.remove('hidden');
    });

    document.getElementById('btn-close-pay-modal')?.addEventListener('click', () => payModal.classList.add('hidden'));
    document.getElementById('btn-cancel-pay-modal')?.addEventListener('click', () => payModal.classList.add('hidden'));

    document.getElementById('btn-confirm-pay')?.addEventListener('click', async () => {
      const amount = Number((document.getElementById('input-pay-amount') as HTMLInputElement).value);
      const method = (document.getElementById('select-pay-method') as HTMLSelectElement).value;
      const ref = (document.getElementById('input-pay-ref') as HTMLInputElement).value;

      const res = await apiFetch<any>('/api/v1/payments/', {
        method: 'POST',
        body: JSON.stringify({
          invoice_id: invId,
          amount,
          payment_method: method,
          reference_note: ref || 'Manual Invoice Settlement',
        }),
      });

      if (res.data) {
        payModal.classList.add('hidden');
        loadInvoiceDetails();
      } else {
        alert(res.error || 'Payment failed');
      }
    });

    function formatUSD(val: number | string | null | undefined): string {
      const num = Number(val || 0);
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
    }

    function getInvoiceClass(status: string): string {
      const map: Record<string, string> = {
        draft: 'bg-slate-100 text-slate-600 border-slate-200',
        confirmed: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        posted: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        paid: 'bg-emerald-50 text-emerald-700 border-emerald-200',
        partially_paid: 'bg-amber-50 text-amber-700 border-amber-200',
        overdue: 'bg-rose-50 text-rose-700 border-rose-200',
        cancelled: 'bg-slate-100 text-slate-600 border-slate-200',
      };
      return map[status?.toLowerCase()] || map.draft;
    }

    loadInvoiceDetails();
  </script>
</Layout>
