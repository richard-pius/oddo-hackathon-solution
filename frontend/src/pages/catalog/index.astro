---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Product Catalog & Variants (+560) — Brightloop ERP" activeNav="catalog" breadcrumbs={[{ label: 'Brightloop ERP', href: '/' }, { label: 'Catalog & Variants' }]}>
  <div class="space-y-4">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div>
        <h1 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
          <span>Products & Variant Matrices</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
            Attribute Modifiers
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Master catalog with Odoo brand variant price modifiers (+$560.00), recurring services, and consumption metrics.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          id="btn-open-new-product" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold transition-colors shadow-xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>New Catalog Item</span>
        </button>
      </div>
    </div>

    <!-- Products & Variants Display -->
    <div id="catalog-container" class="space-y-3">
      <div class="text-center py-8 text-slate-400 text-xs bg-white rounded border border-slate-200">Loading product catalog and variant matrices...</div>
    </div>

  </div>

  <!-- New Product Modal -->
  <div id="modal-product" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-md p-5 max-w-md w-full shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
        <h3 class="font-bold text-slate-900 text-sm">Add New Catalog Product</h3>
        <button id="btn-close-prod-modal" class="text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Product Name</label>
          <input type="text" id="new-prod-name" placeholder="e.g. Odoo Community Connector" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Product Code / SKU</label>
          <input type="text" id="new-prod-code" placeholder="e.g. ODOO-CONN-01" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 font-mono focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Product Type</label>
          <select id="new-prod-type" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]">
            <option value="subscription">Subscription (Recurring SaaS)</option>
            <option value="addon">Addon (Modular Feature)</option>
            <option value="service">Service (Implementation / Support)</option>
            <option value="consumable">Consumable</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Base Price ($)</label>
          <input type="number" step="0.01" id="new-prod-price" placeholder="499.00" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 font-mono text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-prod" class="px-3 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium cursor-pointer">
          Cancel
        </button>
        <button id="btn-save-prod" class="px-3.5 py-1 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs cursor-pointer">
          Save Product
        </button>
      </div>
    </div>
  </div>

  <!-- Add Variant Modal -->
  <div id="modal-variant" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-md p-5 max-w-md w-full shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Add Variant Modifier</h3>
          <p class="text-xs text-slate-500" id="variant-modal-prod-title">Product</p>
        </div>
        <button id="btn-close-var-modal" class="text-slate-400 hover:text-slate-600 p-1 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Attribute Name</label>
          <input type="text" id="new-var-attr" placeholder="e.g. Brand, Hosting, Tier" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Attribute Value</label>
          <input type="text" id="new-var-val" placeholder="e.g. Odoo Enterprise, Dedicated Cloud" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Price Extra Surcharge ($)</label>
          <input type="number" step="0.01" id="new-var-extra" placeholder="560.00" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 font-mono text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-var" class="px-3 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium cursor-pointer">
          Cancel
        </button>
        <button id="btn-save-var" class="px-3.5 py-1 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs cursor-pointer">
          Add Variant
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch } from '../../lib/api';

    let selectedProductIdForVariant: number | null = null;

    async function loadCatalog() {
      const res = await apiFetch<any>('/api/v1/catalog/products');
      const container = document.getElementById('catalog-container');
      if (!container) return;

      if (!res.data) {
        container.innerHTML = `<div class="text-rose-600 py-6 text-center text-xs bg-white rounded border border-slate-200">Error: ${res.error || 'Failed to load catalog'}</div>`;
        return;
      }

      if (res.data.length === 0) {
        container.innerHTML = `<div class="text-slate-400 py-8 text-center text-xs bg-white rounded border border-slate-200">No catalog products configured.</div>`;
        return;
      }

      container.innerHTML = res.data.map((prod: any) => {
        const variants = prod.variants || [];
        const basePrice = Number(prod.sales_price ?? prod.base_price ?? 0);
        const prodCode = prod.notes && prod.notes.includes('Code:') 
          ? prod.notes.split('Code:')[1].trim() 
          : `PROD-${String(prod.id).padStart(3, '0')}`;
        const prodType = (prod.product_type || 'SUBSCRIPTION').toUpperCase();

        return `
          <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-2.5">
              <div>
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#714B67]"></span>
                  <h3 class="text-sm font-bold text-slate-900">${prod.name}</h3>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-medium bg-slate-100 text-slate-700 border border-slate-200">${prodCode}</span>
                  <span class="px-1.5 py-0.5 rounded text-[10px] uppercase font-bold tracking-wider bg-indigo-50 text-indigo-700 border border-indigo-200">${prodType}</span>
                </div>
                <p class="text-xs text-slate-500 mt-0.5">${prod.notes || 'Standard subscription product module'}</p>
              </div>

              <div class="flex items-center gap-4">
                <div class="text-left sm:text-right font-mono">
                  <div class="text-[10px] text-slate-400 uppercase font-sans font-medium">Base Price</div>
                  <div class="text-base font-bold text-slate-900">${formatUSD(basePrice)}</div>
                </div>
                <button
                  class="btn-add-var-trigger px-2.5 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors shadow-2xs cursor-pointer"
                  data-prod-id="${prod.id}"
                  data-prod-name="${prod.name}"
                  title="Add variant attribute modifier"
                >
                  + Add Variant
                </button>
              </div>
            </div>

            <!-- Variants Table -->
            <div class="space-y-1.5">
              <div class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 flex items-center justify-between">
                <span>Configured Variants (${variants.length})</span>
                <span class="text-[#714B67] font-mono text-[10px]">Variant Price Surcharge</span>
              </div>

              <div class="overflow-x-auto border border-slate-200 rounded">
                <table class="erp-table">
                  <thead>
                    <tr>
                      <th class="w-36">Variant SKU</th>
                      <th>Attributes Matrix</th>
                      <th class="w-32">Price Extra</th>
                      <th class="text-right w-40">Effective Unit Price</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="font-mono text-slate-500 text-xs">DEFAULT-STD</td>
                      <td class="text-slate-500 text-xs">Standard Baseline (No attributes)</td>
                      <td class="font-mono text-slate-500 text-xs">+$0.00</td>
                      <td class="text-right font-mono font-bold text-slate-900">${formatUSD(basePrice)}</td>
                    </tr>
                    ${variants.map((v: any) => {
                      const attrName = v.attribute_name || 'Attribute';
                      const attrVal = v.attribute_value || 'Default';
                      const attrBadge = `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200 text-xs"><span class="text-slate-500">${attrName}:</span> <strong class="text-slate-900 font-semibold">${attrVal}</strong></span>`;
                      const extra = Number(v.price_extra || 0);
                      const effective = basePrice + extra;
                      const sku = `VAR-${prod.id}-${v.id}`;
                      return `
                        <tr>
                          <td class="font-mono font-semibold text-slate-800 text-xs">${sku}</td>
                          <td>${attrBadge}</td>
                          <td class="font-mono font-bold text-emerald-700 text-xs">+${formatUSD(extra)}</td>
                          <td class="text-right font-mono font-bold text-slate-900">${formatUSD(effective)}</td>
                        </tr>
                      `;
                    }).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        `;
      }).join('');

      // Wire up Add Variant buttons
      document.querySelectorAll('.btn-add-var-trigger').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          selectedProductIdForVariant = Number(target.dataset.prodId);
          const prodName = target.dataset.prodName || '';
          const titleEl = document.getElementById('variant-modal-prod-title');
          if (titleEl) titleEl.textContent = `Configuring for: ${prodName}`;
          modalVar.classList.remove('hidden');
        });
      });
    }

    function formatUSD(val: number | string | null | undefined): string {
      const num = Number(val || 0);
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(isNaN(num) ? 0 : num);
    }

    // New Product Modal Handling
    const modal = document.getElementById('modal-product')!;
    document.getElementById('btn-open-new-product')?.addEventListener('click', () => modal.classList.remove('hidden'));
    document.getElementById('btn-close-prod-modal')?.addEventListener('click', () => modal.classList.add('hidden'));
    document.getElementById('btn-cancel-prod')?.addEventListener('click', () => modal.classList.add('hidden'));

    document.getElementById('btn-save-prod')?.addEventListener('click', async () => {
      const name = (document.getElementById('new-prod-name') as HTMLInputElement).value.trim();
      const code = (document.getElementById('new-prod-code') as HTMLInputElement).value.trim();
      const type = (document.getElementById('new-prod-type') as HTMLSelectElement).value;
      const price = Number((document.getElementById('new-prod-price') as HTMLInputElement).value || 0);

      if (!name) {
        alert('Product Name is required');
        return;
      }

      const res = await apiFetch<any>('/api/v1/catalog/products', {
        method: 'POST',
        body: JSON.stringify({
          name,
          product_type: type,
          sales_price: price,
          cost_price: Math.round(price * 0.4 * 100) / 100,
          notes: code ? `Code: ${code}` : 'Standard product module',
          is_active: true,
        }),
      });

      if (res.data) {
        modal.classList.add('hidden');
        (document.getElementById('new-prod-name') as HTMLInputElement).value = '';
        (document.getElementById('new-prod-code') as HTMLInputElement).value = '';
        (document.getElementById('new-prod-price') as HTMLInputElement).value = '';
        loadCatalog();
      } else {
        alert(res.error || 'Failed to create product');
      }
    });

    // Add Variant Modal Handling
    const modalVar = document.getElementById('modal-variant')!;
    document.getElementById('btn-close-var-modal')?.addEventListener('click', () => modalVar.classList.add('hidden'));
    document.getElementById('btn-cancel-var')?.addEventListener('click', () => modalVar.classList.add('hidden'));

    document.getElementById('btn-save-var')?.addEventListener('click', async () => {
      if (!selectedProductIdForVariant) return;

      const attrName = (document.getElementById('new-var-attr') as HTMLInputElement).value.trim();
      const attrVal = (document.getElementById('new-var-val') as HTMLInputElement).value.trim();
      const extra = Number((document.getElementById('new-var-extra') as HTMLInputElement).value || 0);

      if (!attrName || !attrVal) {
        alert('Attribute Name and Value are required');
        return;
      }

      const res = await apiFetch<any>(`/api/v1/catalog/products/${selectedProductIdForVariant}/variants`, {
        method: 'POST',
        body: JSON.stringify({
          attribute_name: attrName,
          attribute_value: attrVal,
          price_extra: extra,
          is_active: true,
        }),
      });

      if (res.data) {
        modalVar.classList.add('hidden');
        (document.getElementById('new-var-attr') as HTMLInputElement).value = '';
        (document.getElementById('new-var-val') as HTMLInputElement).value = '';
        (document.getElementById('new-var-extra') as HTMLInputElement).value = '';
        loadCatalog();
      } else {
        alert(res.error || 'Failed to add variant');
      }
    });

    loadCatalog();
  </script>
</Layout>
