---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="System Administration & Staff — Brightloop ERP"
  activeNav="admin"
  breadcrumbs={[
    { label: 'Brightloop ERP', href: '/' },
    { label: 'Administration' },
    { label: 'Staff & Access' },
  ]}
>
  <div class="max-w-6xl mx-auto space-y-5">
    
    <!-- Top Action Toolbar & Title -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div>
        <h1 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
          <span>System Administration & Role Directory</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase bg-rose-50 text-rose-700 border border-rose-200">
            Admin Tier
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Role-Based Access Control (RBAC), internal staff provisioning, and tenant access isolation.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button
          id="btn-refresh-users"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
          </svg>
          <span>Refresh Directory</span>
        </button>
      </div>
    </div>

    <!-- Security & RBAC Overview Strip -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 text-xs">
      <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
        <div class="text-slate-400 text-[10px] uppercase font-bold tracking-wider">Total Accounts</div>
        <div class="text-xl font-bold font-mono text-slate-900 mt-0.5" id="stat-total-users">0</div>
        <div class="text-[10px] text-slate-500 mt-1">Registered in database</div>
      </div>
      <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
        <div class="text-slate-400 text-[10px] uppercase font-bold tracking-wider">Administrators</div>
        <div class="text-xl font-bold font-mono text-indigo-700 mt-0.5" id="stat-admin-users">0</div>
        <div class="text-[10px] text-indigo-600 mt-1">Full control tier</div>
      </div>
      <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
        <div class="text-slate-400 text-[10px] uppercase font-bold tracking-wider">Internal Staff</div>
        <div class="text-xl font-bold font-mono text-emerald-700 mt-0.5" id="stat-staff-users">0</div>
        <div class="text-[10px] text-emerald-600 mt-1">Operational billing access</div>
      </div>
      <div class="bg-white p-3 rounded border border-slate-200 shadow-2xs">
        <div class="text-slate-400 text-[10px] uppercase font-bold tracking-wider">Customer Tenants</div>
        <div class="text-xl font-bold font-mono text-slate-800 mt-0.5" id="stat-customer-users">0</div>
        <div class="text-[10px] text-slate-500 mt-1">Isolated portal-only tier</div>
      </div>
    </div>

    <!-- Main Grid: Provision Staff (Left) + Users Directory (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
      
      <!-- Staff Provisioning Form (Admin Only) -->
      <div class="bg-white border border-slate-200 rounded-md p-5 shadow-xs h-fit space-y-4">
        <div>
          <h2 class="text-sm font-bold text-slate-900 tracking-tight flex items-center gap-1.5">
            <svg class="w-4 h-4 text-[#714B67]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
            <span>Provision Internal Staff</span>
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Admins alone can create <span class="font-mono text-slate-700 font-semibold">INTERNAL_STAFF</span> accounts.
          </p>
        </div>

        <div id="staff-form-alert" class="hidden p-3 rounded text-xs border"></div>

        <form id="create-staff-form" class="space-y-3.5" novalidate>
          <div>
            <label for="staff-name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Full Name
            </label>
            <input
              id="staff-name"
              type="text"
              required
              placeholder="e.g. David Kumar"
              class="block w-full px-3 py-1.5 text-xs text-slate-900 bg-white border border-slate-300 rounded focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2]"
            />
          </div>

          <div>
            <label for="staff-email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Corporate Email Address
            </label>
            <input
              id="staff-email"
              type="email"
              required
              placeholder="name@brightloop.io"
              class="block w-full px-3 py-1.5 text-xs text-slate-900 bg-white border border-slate-300 rounded focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2]"
            />
          </div>

          <div>
            <label for="staff-password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">
              Temporary Password
            </label>
            <input
              id="staff-password"
              type="password"
              required
              placeholder="••••••••••••"
              class="block w-full px-3 py-1.5 text-xs text-slate-900 bg-white border border-slate-300 rounded focus:outline-none focus:ring-1 focus:ring-[#1877F2] focus:border-[#1877F2]"
            />

            <!-- Strict Password Checklist -->
            <div class="mt-2 p-2 rounded bg-slate-50 border border-slate-200 text-[10px] space-y-1">
              <div class="font-bold text-slate-600 uppercase">Strict Password Rules:</div>
              <div id="pwd-rule-len" class="flex items-center gap-1.5 text-slate-500">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dot"></span>
                <span>Minimum 9 characters</span>
              </div>
              <div id="pwd-rule-upper" class="flex items-center gap-1.5 text-slate-500">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dot"></span>
                <span>At least one uppercase letter (A-Z)</span>
              </div>
              <div id="pwd-rule-lower" class="flex items-center gap-1.5 text-slate-500">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dot"></span>
                <span>At least one lowercase letter (a-z)</span>
              </div>
              <div id="pwd-rule-special" class="flex items-center gap-1.5 text-slate-500">
                <span class="w-1.5 h-1.5 rounded-full bg-slate-300 dot"></span>
                <span>At least one special character (!@#$%^&*...)</span>
              </div>
            </div>
          </div>

          <button
            type="submit"
            id="btn-create-staff"
            class="w-full py-2 px-3 rounded bg-[#1877F2] hover:bg-[#166fe5] text-white text-xs font-semibold transition-colors flex items-center justify-center gap-1.5 shadow-2xs cursor-pointer disabled:opacity-50"
          >
            <span id="btn-create-staff-text">Create Staff Account</span>
            <svg id="btn-create-staff-spinner" class="hidden w-3.5 h-3.5 animate-spin text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <div class="border-t border-slate-100 pt-3 text-[11px] text-slate-500 leading-tight">
          Role is permanently assigned as <strong class="text-slate-700">INTERNAL_STAFF</strong>. Staff users can manage subscriptions, approve quotations, and trigger billing runs, but cannot create accounts.
        </div>
      </div>

      <!-- Users Directory Table (Right 2 cols) -->
      <div class="lg:col-span-2 bg-white border border-slate-200 rounded-md shadow-xs overflow-hidden flex flex-col">
        <div class="p-3.5 border-b border-slate-200 flex items-center justify-between bg-slate-50/50">
          <div>
            <h2 class="font-bold text-slate-900 text-sm">Enterprise Identity Ledger</h2>
            <p class="text-xs text-slate-500">Active users across all 3 permission tiers.</p>
          </div>
          <span class="text-xs text-slate-500 font-mono" id="users-count-tag">0 Users</span>
        </div>

        <div class="overflow-x-auto flex-1">
          <table class="erp-table">
            <thead>
              <tr>
                <th>User / Organization</th>
                <th>Role Tier</th>
                <th>Status</th>
                <th>Registered</th>
              </tr>
            </thead>
            <tbody id="users-table-body">
              <tr>
                <td colspan="4" class="py-8 text-center text-slate-400 text-xs">Loading identity directory...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </div>

  <script>
    import { apiFetch, API_URL } from '../../lib/api';

    // Verify Admin role immediately
    const userRaw = localStorage.getItem('brightloop_user');
    if (userRaw) {
      try {
        const u = JSON.parse(userRaw);
        if (u.role !== 'admin') {
          alert('Access Restricted: Administration requires ADMIN tier privileges.');
          window.location.replace('/');
        }
      } catch (e) {}
    }

    // Password validation helper
    const pwdInput = document.getElementById('staff-password') as HTMLInputElement;
    const ruleLen = document.getElementById('pwd-rule-len');
    const ruleUpper = document.getElementById('pwd-rule-upper');
    const ruleLower = document.getElementById('pwd-rule-lower');
    const ruleSpecial = document.getElementById('pwd-rule-special');

    function updateStaffPwdRules(val: string) {
      const isLen = val.length >= 9;
      const isUp = /[A-Z]/.test(val);
      const isLow = /[a-z]/.test(val);
      const isSpec = /[!@#$%^&*(),.?":{}|<>\-_+=]/.test(val);

      setRule(ruleLen, isLen);
      setRule(ruleUpper, isUp);
      setRule(ruleLower, isLow);
      setRule(ruleSpecial, isSpec);

      return isLen && isUp && isLow && isSpec;
    }

    function setRule(el: HTMLElement | null, valid: boolean) {
      if (!el) return;
      const dot = el.querySelector('.dot');
      if (valid) {
        el.classList.remove('text-slate-500');
        el.classList.add('text-emerald-700', 'font-medium');
        dot?.classList.remove('bg-slate-300');
        dot?.classList.add('bg-emerald-500');
      } else {
        el.classList.remove('text-emerald-700', 'font-medium');
        el.classList.add('text-slate-500');
        dot?.classList.remove('bg-emerald-500');
        dot?.classList.add('bg-slate-300');
      }
    }

    if (pwdInput) {
      pwdInput.addEventListener('input', () => updateStaffPwdRules(pwdInput.value));
    }

    // Load Users
    async function loadUsers() {
      const res = await apiFetch<any[]>('/api/v1/auth/users');
      const tbody = document.getElementById('users-table-body');
      const countTag = document.getElementById('users-count-tag');
      const statTotal = document.getElementById('stat-total-users');
      const statAdmin = document.getElementById('stat-admin-users');
      const statStaff = document.getElementById('stat-staff-users');
      const statCust = document.getElementById('stat-customer-users');

      if (!res.data || !tbody) {
        if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-rose-500 text-xs">Failed to load directory. Ensure you are signed in as ADMIN.</td></tr>';
        return;
      }

      const users = res.data;
      if (countTag) countTag.textContent = `${users.length} Users`;
      if (statTotal) statTotal.textContent = String(users.length);

      let admins = 0, staff = 0, customers = 0;
      users.forEach(u => {
        const r = (u.role || '').toUpperCase();
        if (r === 'ADMIN') admins++;
        else if (r === 'INTERNAL_STAFF') staff++;
        else customers++;
      });

      if (statAdmin) statAdmin.textContent = String(admins);
      if (statStaff) statStaff.textContent = String(staff);
      if (statCust) statCust.textContent = String(customers);

      tbody.innerHTML = users.map(u => {
        const r = (u.role || '').toUpperCase();
        let roleBadge = '';
        if (r === 'ADMIN') {
          roleBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">ADMIN</span>';
        } else if (r === 'INTERNAL_STAFF') {
          roleBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">INTERNAL STAFF</span>';
        } else {
          roleBadge = '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700 border border-slate-200">CUSTOMER</span>';
        }

        const dateStr = u.created_at ? new Date(u.created_at).toLocaleDateString() : '—';
        const initials = u.full_name ? u.full_name.split(' ').map((n: string) => n[0]).join('').substring(0, 2).toUpperCase() : 'U';

        return `
          <tr class="hover:bg-slate-50 transition-colors">
            <td>
              <div class="flex items-center gap-2.5">
                <div class="w-6 h-6 rounded bg-[#714B67] text-white flex items-center justify-center font-bold text-[10px] shrink-0">
                  ${initials}
                </div>
                <div>
                  <div class="font-bold text-slate-900 text-xs">${u.full_name}</div>
                  <div class="text-[11px] text-slate-500 font-mono">${u.email}</div>
                </div>
              </div>
            </td>
            <td>${roleBadge}</td>
            <td>
              <span class="inline-flex items-center gap-1.5 text-xs ${u.is_active ? 'text-emerald-700' : 'text-slate-400'} font-medium">
                <span class="w-1.5 h-1.5 rounded-full ${u.is_active ? 'bg-emerald-500' : 'bg-slate-300'}"></span>
                <span>${u.is_active ? 'Active' : 'Inactive'}</span>
              </span>
            </td>
            <td class="font-mono text-xs text-slate-600">${dateStr}</td>
          </tr>
        `;
      }).join('');
    }

    loadUsers();

    const btnRefresh = document.getElementById('btn-refresh-users');
    if (btnRefresh) {
      btnRefresh.addEventListener('click', loadUsers);
    }

    // Create Staff Submission
    const staffForm = document.getElementById('create-staff-form') as HTMLFormElement;
    const nameInput = document.getElementById('staff-name') as HTMLInputElement;
    const emailInput = document.getElementById('staff-email') as HTMLInputElement;
    const formAlert = document.getElementById('staff-form-alert');
    const btnSubmit = document.getElementById('btn-create-staff') as HTMLButtonElement;
    const btnSubmitText = document.getElementById('btn-create-staff-text');
    const btnSubmitSpinner = document.getElementById('btn-create-staff-spinner');

    if (staffForm) {
      staffForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (formAlert) formAlert.className = 'hidden';

        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        const password = pwdInput.value;

        if (!name || !email || !password) {
          showAlert('Please fill in all fields.', 'error');
          return;
        }

        if (!updateStaffPwdRules(password)) {
          showAlert('Password must meet all 4 complexity requirements.', 'error');
          return;
        }

        btnSubmit.disabled = true;
        btnSubmitText?.classList.add('opacity-0');
        btnSubmitSpinner?.classList.remove('hidden');

        try {
          const res = await apiFetch<any>('/api/v1/auth/staff', {
            method: 'POST',
            body: JSON.stringify({
              full_name: name,
              email: email,
              password: password,
            }),
          });

          if (res.data) {
            showAlert(`Staff account created successfully for ${res.data.full_name} (${res.data.email}).`, 'success');
            staffForm.reset();
            updateStaffPwdRules('');
            await loadUsers();
          } else {
            showAlert(res.error || 'Failed to create staff account.', 'error');
          }
        } catch (err: any) {
          showAlert(err.message || 'Error communicating with server.', 'error');
        } finally {
          btnSubmit.disabled = false;
          btnSubmitText?.classList.remove('opacity-0');
          btnSubmitSpinner?.classList.add('hidden');
        }
      });
    }

    function showAlert(msg: string, type: 'success' | 'error') {
      if (!formAlert) return;
      formAlert.textContent = msg;
      if (type === 'success') {
        formAlert.className = 'p-3 rounded text-xs border border-emerald-200 bg-emerald-50 text-emerald-800 font-medium block';
      } else {
        formAlert.className = 'p-3 rounded text-xs border border-rose-200 bg-rose-50 text-rose-800 font-medium block';
      }
    }
  </script>
</Layout>
