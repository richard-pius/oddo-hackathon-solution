---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Customer Self-Service Portal — Brightloop ERP" activeNav="portal" breadcrumbs={[{ label: 'Brightloop ERP', href: '/' }, { label: 'Customer Portal' }]}>
  <div class="max-w-5xl mx-auto space-y-4">
    
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 pb-3">
      <div>
        <h1 class="text-xl font-bold text-slate-900 tracking-tight flex items-center gap-2">
          <span>Customer Self-Service Portal</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200">
            Tenant View
          </span>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Review your software subscription contracts, renewal dates, and settle invoices with zero friction.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <button 
          id="btn-login-customer-demo" 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold shadow-2xs"
        >
          <svg class="w-3.5 h-3.5 text-[#714B67]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <span>1-Click Switch: Acmez Customer</span>
        </button>
      </div>
    </div>

    <!-- Active Subscription Cards -->
    <div class="space-y-2.5">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Your Active Contracts</h2>
        <span class="text-xs text-slate-600 font-mono font-medium" id="portal-sub-count">... Contracts</span>
      </div>

      <div id="portal-subs-container" class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="text-xs text-slate-400 py-6 text-center col-span-2 bg-white rounded border border-slate-200">Loading your contracts...</div>
      </div>
    </div>

    <!-- Invoices & Billing Statements -->
    <div class="space-y-2.5 pt-2">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Invoices & Billing Statements</h2>
        <span class="text-xs text-amber-800 font-mono font-bold" id="portal-due-summary">Outstanding: $0.00</span>
      </div>

      <div class="bg-white border border-slate-200 rounded-md shadow-xs overflow-hidden">
        <div class="overflow-x-auto">
          <table class="erp-table">
            <thead>
              <tr>
                <th>Invoice #</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Total Amount</th>
                <th>Balance Due</th>
                <th>Status</th>
                <th class="text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="portal-invoices-table">
              <tr>
                <td colspan="7" class="py-8 text-center text-slate-400 text-xs">Loading invoices...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <!-- Instant Card Checkout Modal -->
  <div id="portal-pay-modal" class="hidden fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-white border border-slate-200 rounded-md p-5 max-w-md w-full shadow-lg space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2.5">
        <div>
          <h3 class="font-bold text-slate-900 text-sm">Instant Invoice Checkout</h3>
          <p class="text-xs text-slate-500">Secured with 256-bit PCI-DSS encryption</p>
        </div>
        <button id="btn-close-portal-pay" class="text-slate-400 hover:text-slate-600 p-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="bg-slate-50 p-3 rounded border border-slate-200 space-y-1 font-mono text-xs">
        <div class="flex justify-between text-slate-600">
          <span>Invoice To Settle:</span>
          <span class="text-slate-900 font-bold" id="modal-inv-id">INV-...</span>
        </div>
        <div class="flex justify-between text-slate-600">
          <span>Total Balance Due:</span>
          <span class="text-emerald-700 font-extrabold text-sm" id="modal-inv-due">$0.00</span>
        </div>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-semibold text-slate-700 mb-1">Cardholder Name</label>
          <input type="text" id="pay-name" placeholder="Acmez Enterprise Finance" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>

        <div>
          <label class="block font-semibold text-slate-700 mb-1">Card Number</label>
          <input type="text" placeholder="4242 •••• •••• 4242" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 font-mono focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-semibold text-slate-700 mb-1">Expires</label>
            <input type="text" placeholder="MM/YY" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 font-mono text-center focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
          </div>
          <div>
            <label class="block font-semibold text-slate-700 mb-1">CVC</label>
            <input type="text" placeholder="•••" class="w-full bg-white border border-slate-300 rounded px-2.5 py-1.5 text-xs text-slate-900 font-mono text-center focus:outline-none focus:ring-1 focus:ring-[#714B67]" />
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
        <button id="btn-cancel-portal-pay" class="px-3 py-1 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium">
          Cancel
        </button>
        <button id="btn-submit-portal-pay" class="px-4 py-1 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white text-xs font-semibold shadow-xs">
          Pay Now
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiFetch, API_URL, loginAs } from '../../lib/api';

    let currentInvToPay: any = null;

    async function loadPortalData() {
      const [subsRes, invsRes] = await Promise.all([
        apiFetch<any>('/api/v1/subscriptions/'),
        apiFetch<any>('/api/v1/billing/invoices'),
      ]);

      // Subscriptions
      const subsBox = document.getElementById('portal-subs-container')!;
      const subCount = document.getElementById('portal-sub-count')!;

      if (subsRes.data?.items) {
        subCount.textContent = `${subsRes.data.items.length} Contracts`;
        if (subsRes.data.items.length === 0) {
          subsBox.innerHTML = '<div class="text-xs text-slate-400 py-6 text-center col-span-2 bg-white rounded border border-slate-200">No active subscriptions found for this account.</div>';
        } else {
          subsBox.innerHTML = subsRes.data.items.map((s: any) => `
            <div class="bg-white border border-slate-200 rounded-md p-4 shadow-2xs space-y-2.5">
              <div class="flex items-center justify-between">
                <div>
                  <div class="font-mono font-bold text-slate-900 text-sm">${s.subscription_number}</div>
                  <div class="text-xs text-slate-500">${s.plan_name || 'Standard'} Plan</div>
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200">
                  ${s.status}
                </span>
              </div>

              <div class="bg-slate-50 p-2.5 rounded border border-slate-200 grid grid-cols-2 gap-2 text-xs font-mono">
                <div>
                  <div class="text-[10px] text-slate-500 font-sans">Recurring Fee</div>
                  <div class="font-bold text-slate-900 text-sm">${formatUSD(s.total_recurring)}</div>
                </div>
                <div>
                  <div class="text-[10px] text-slate-500 font-sans">Next Renewal</div>
                  <div class="font-semibold text-slate-800">${s.next_billing_date || 'N/A'}</div>
                </div>
              </div>

              <div class="flex items-center justify-between text-xs pt-0.5">
                <span class="text-slate-400 text-[11px]">Billed every ${s.billing_interval || 'Month'}</span>
                <a href="/subscriptions/${s.id}" class="text-indigo-600 hover:text-indigo-800 font-semibold">
                  Manage Contract &rarr;
                </a>
              </div>
            </div>
          `).join('');
        }
      }

      // Invoices
      const invTable = document.getElementById('portal-invoices-table')!;
      const dueSummary = document.getElementById('portal-due-summary')!;

      if (invsRes.data?.items) {
        let totalDue = 0;
        invsRes.data.items.forEach((i: any) => totalDue += Number(i.amount_due || 0));
        dueSummary.textContent = `Outstanding Balance: ${formatUSD(totalDue)}`;

        if (invsRes.data.items.length === 0) {
          invTable.innerHTML = '<tr><td colspan="7" class="py-6 text-center text-slate-400 text-xs">No invoices recorded yet.</td></tr>';
        } else {
          invTable.innerHTML = invsRes.data.items.map((i: any) => `
            <tr>
              <td class="font-mono font-bold text-slate-900">
                <a href="/invoices/${i.id}" class="hover:text-[#714B67] underline decoration-slate-300">
                  ${i.invoice_number}
                </a>
              </td>
              <td class="font-mono text-slate-600 text-xs">${i.issue_date}</td>
              <td class="font-mono text-slate-600 text-xs">${i.due_date}</td>
              <td class="font-mono font-bold text-slate-900">${formatUSD(i.total_amount)}</td>
              <td class="font-mono font-bold ${i.amount_due > 0 ? 'text-amber-700' : 'text-slate-500'}">${formatUSD(i.amount_due)}</td>
              <td>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider border ${getInvoiceClass(i.status)}">
                  ${i.status}
                </span>
              </td>
              <td class="text-right">
                <div class="inline-flex items-center gap-1.5">
                  <a 
                    href="${API_URL}/api/v1/billing/invoices/${i.id}/pdf?token=" + encodeURIComponent(localStorage.getItem("brightloop_token") || "") 
                    target="_blank" 
                    class="px-2 py-0.5 rounded border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-medium text-[11px] shadow-2xs"
                  >
                    PDF
                  </a>
                  ${i.amount_due > 0 ? `
                    <button 
                      class="btn-portal-pay px-2.5 py-0.5 rounded bg-[#714B67] hover:bg-[#5a3c53] text-white font-semibold text-[11px] shadow-2xs"
                      data-inv='${JSON.stringify(i)}'
                    >
                      Pay ${formatUSD(i.amount_due)}
                    </button>
                  ` : `
                    <span class="px-2 py-0.5 text-[11px] text-emerald-700 font-semibold">Settled</span>
                  `}
                </div>
              </td>
            </tr>
          `).join('');

          document.querySelectorAll('.btn-portal-pay').forEach(btn => {
            btn.addEventListener('click', (e) => {
              const raw = (e.currentTarget as HTMLElement).dataset.inv!;
              openCheckoutModal(JSON.parse(raw));
            });
          });
        }
      }
    }

    function openCheckoutModal(inv: any) {
      currentInvToPay = inv;
      const modal = document.getElementById('portal-pay-modal')!;
      document.getElementById('modal-inv-id')!.textContent = inv.invoice_number;
      document.getElementById('modal-inv-due')!.textContent = formatUSD(inv.amount_due);
      modal.classList.remove('hidden');
    }

    document.getElementById('btn-close-portal-pay')?.addEventListener('click', () => {
      document.getElementById('portal-pay-modal')?.classList.add('hidden');
    });
    document.getElementById('btn-cancel-portal-pay')?.addEventListener('click', () => {
      document.getElementById('portal-pay-modal')?.classList.add('hidden');
    });

    document.getElementById('btn-submit-portal-pay')?.addEventListener('click', async () => {
      if (!currentInvToPay) return;
      const btn = document.getElementById('btn-submit-portal-pay') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Processing...';

      const res = await apiFetch<any>('/api/v1/payments/', {
        method: 'POST',
        body: JSON.stringify({
          invoice_id: currentInvToPay.id,
          amount: currentInvToPay.amount_due,
          payment_method: 'credit_card',
          reference_note: 'Customer Portal Card Checkout',
        }),
      });

      if (res.data) {
        document.getElementById('portal-pay-modal')?.classList.add('hidden');
        alert(`✅ Payment confirmed for ${currentInvToPay.invoice_number}`);
        loadPortalData();
      } else {
        alert(res.error || 'Payment failed');
      }
      btn.disabled = false;
      btn.textContent = 'Pay Now';
    });

    document.getElementById('btn-login-customer-demo')?.addEventListener('click', async () => {
      await loginAs('customer@brightloop.io', 'BrightloopCustomer2026!');
      window.location.reload();
    });

    function formatUSD(val: number | string | null | undefined): string {
      const num = Number(val || 0);
      return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(num);
    }

    function getInvoiceClass(status: string): string {
      const map: Record<string, string> = {
        draft: 'bg-slate-100 text-slate-600 border-slate-200',
        confirmed: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        posted: 'bg-indigo-50 text-indigo-700 border-indigo-200',
        paid: 'bg-emerald-50 text-emerald-700 border-emerald-200',
        partially_paid: 'bg-amber-50 text-amber-700 border-amber-200',
        overdue: 'bg-rose-50 text-rose-700 border-rose-200',
        cancelled: 'bg-slate-100 text-slate-600 border-slate-200',
      };
      return map[status?.toLowerCase()] || map.draft;
    }

    loadPortalData();
  </script>
</Layout>
